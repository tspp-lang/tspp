/*
  Copy this file into '.vscode/launch.json' or merge its
  contents into your existing configurations.
*/

{
  "version": "0.2.0",
  "configurations": [
    {
      // Builds the compiler and language server, then opens the extension host.
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-extension",
        "--disable-extensions",
        "${workspaceFolder}/packages/examples"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/vscode-extension/**/*.js"
      ],
      "preLaunchTask": "${defaultBuildTask}"
    },
    {
      // Builds the current compiler bundle, starts Vite, and opens the playground.
      "name": "TS++: Playground",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173/?ts=dev",
      "webRoot": "${workspaceFolder}/packages/playground",
      "preLaunchTask": "pnpm: playground:debug"
    }
  ]
}
