/*
  Copy this file into '.vscode/launch.json' or merge its
  contents into your existing configurations.
*/

{
  "version": "0.2.0",
  "configurations": [
    {
      // Builds the compiler and language server, then opens the extension host in a persistent terminal.
      "name": "TS++: Launch in Terminal (Keep Alive)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/launch-editor.mjs",
      "console": "integratedTerminal"
    },
    {
      // Starts the playground dev server on the compiler sources and opens it.
      "name": "TS++: Playground",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173/",
      "webRoot": "${workspaceFolder}/packages/playground",
      "preLaunchTask": "pnpm: playground:dev"
    }
  ]
}
