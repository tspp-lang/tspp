{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TS++: Launch in Terminal (Keep Alive)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/launch-editor.mjs",
      "console": "integratedTerminal"
    },
    {
      "name": "TS++: Playground",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173/",
      "webRoot": "${workspaceFolder}/packages/playground",
      "preLaunchTask": "pnpm: playground:dev"
    }
  ]
}
