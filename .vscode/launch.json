{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-extension",
        "--disable-extensions",
        "${workspaceFolder}/packages/examples"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/vscode-extension/**/*.js"
      ],
      "preLaunchTask": "${defaultBuildTask}"
    },
    {
      "name": "TS++: Launch in Terminal (Keep Alive)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/launch-editor.mjs",
      "console": "integratedTerminal"
    },
    {
      "name": "TS++: Playground",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173/?ts=dev",
      "webRoot": "${workspaceFolder}/packages/playground",
      "preLaunchTask": "pnpm: playground:debug"
    }
  ]
}
