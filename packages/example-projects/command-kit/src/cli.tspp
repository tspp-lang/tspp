#!/usr/bin/env node
import {
  Command, flag, option, argument, optionalArgument,
  integer, text, customCodec, Decoded, DecodeFailed,
} from "./index.js";
import { CommandOutput } from "./runtime.js";
import { runNode } from "./node.js";
import { catalog, displayPath } from "./workspace/catalog.js";

const positiveInteger = customCodec("positive integer", raw => {
  const decoded = integer().decode(raw);
  return match decoded {
    Decoded(value) => value > 0 ? Decoded(value) : DecodeFailed("must be greater than zero"),
    DecodeFailed(message) => DecodeFailed(message),
  };
});

const json = flag("json", { short: "j", description: "Write machine-readable JSON" });
const scope = option("scope", text(), { short: "s", description: "Filter package names by prefix" }).withDefault("");
const limit = option("limit", positiveInteger, {
  short: "n", env: "COMMAND_KIT_LIMIT", description: "Maximum number of listed packages",
}).withDefault(100);
const directory = optionalArgument("directory", text(), { description: "Repository or package directory (default: current directory)" });
const packageName = argument("package", text(), { description: "Package whose local dependencies should be shown" });

const list = new Command("list", "List repository packages").option(limit).argument(directory);
const deps = new Command("deps", "Show direct dependencies that exist in this repository").argument(packageName).argument(directory);
const app = new Command("command-kit", "Inspect package manifests in a repository's packages tree")
  .version("0.1.0")
  .option(json)
  .option(scope)
  .command(list)
  .command(deps);

process.exitCode = runNode(app, invocation => {
  if (invocation.command === app) return new CommandOutput(0, app.help());
  try {
    const root = invocation.get(directory) ?? ".";
    const packages = catalog(root);
    const prefix = invocation.get(scope);
    if (invocation.command === list) {
      const selected = packages.filter(item => item.name.startsWith(prefix)).slice(0, invocation.get(limit));
      const output = invocation.get(json)
        ? JSON.stringify(selected.map(item => ({ ...item, directory: displayPath(root, item.directory) })), null, 2)
        : selected.map(item => `${item.name}\t${item.version}\t${displayPath(root, item.directory)}`).join("\n");
      return new CommandOutput(0, output);
    }
    const name = invocation.get(packageName);
    const target = packages.find(item => item.name === name);
    if (!target) return new CommandOutput(1, "", `Package not found: ${name}`);
    const localNames = new Set(packages.map(item => item.name));
    const selected = target.dependencies.filter(name => localNames.has(name) && name.startsWith(prefix));
    return new CommandOutput(0, invocation.get(json) ? JSON.stringify(selected, null, 2) : selected.join("\n"));
  } catch (error) {
    return new CommandOutput(1, "", error instanceof Error ? error.message : String(error));
  }
});
