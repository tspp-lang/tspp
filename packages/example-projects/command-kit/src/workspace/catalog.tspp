import { existsSync, readdirSync, readFileSync } from "node:fs";
import { join, relative, resolve } from "node:path";

export interface PackageInfo {
  name: string;
  version: string;
  directory: string;
  dependencies: readonly string[];
}

function record(value: unknown): value is Record<string, unknown> {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}

function loadPackage(directory: string): PackageInfo {
  const raw: unknown = JSON.parse(readFileSync(join(directory, "package.json"), "utf8"));
  if (!record(raw) || typeof raw.name !== "string" || raw.name.length === 0) {
    throw new Error(`Invalid package name in ${join(directory, "package.json")}`);
  }
  const dependencies = new Set<string>();
  for (const key of ["dependencies", "devDependencies", "peerDependencies", "optionalDependencies"]) {
    const entries = raw[key];
    if (entries !== undefined && !record(entries)) throw new Error(`Invalid ${key} in ${raw.name}`);
    if (record(entries)) for (const name of Object.keys(entries)) dependencies.add(name);
  }
  return {
    name: raw.name,
    version: typeof raw.version === "string" ? raw.version : "(unversioned)",
    directory,
    dependencies: [...dependencies].sort(),
  };
}

/** Catalog this repository's packages tree without entering package internals or symlinks. */
export function catalog(directory: string): readonly PackageInfo[] {
  const root = resolve(directory);
  const packages: PackageInfo[] = [];
  const walk = (current: string): void => {
    if (existsSync(join(current, "package.json"))) {
      packages.push(loadPackage(current));
      return;
    }
    for (const entry of readdirSync(current, { withFileTypes: true })) {
      if (entry.isDirectory() && !entry.name.startsWith(".") && entry.name !== "node_modules") {
        walk(join(current, entry.name));
      }
    }
  };
  if (existsSync(join(root, "package.json"))) {
    packages.push(loadPackage(root));
    if (existsSync(join(root, "packages"))) walk(join(root, "packages"));
  } else {
    walk(root);
  }
  const names = new Set<string>();
  for (const item of packages) {
    if (names.has(item.name)) throw new Error(`Duplicate package name: ${item.name}`);
    names.add(item.name);
  }
  return packages.sort((left, right) => left.name.localeCompare(right.name));
}

export function displayPath(root: string, directory: string): string {
  return relative(resolve(root), directory).replaceAll("\\", "/") || ".";
}
