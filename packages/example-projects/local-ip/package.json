{
  "name": "@tspp/local-ip",
  "version": "0.0.0",
  "private": true,
  "description": "List local network interface addresses.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "tsppTypes": "./dist/index.d.tspp",
  "exports": { ".": { "tspp-types": "./dist/index.d.tspp", "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "bin": { "local-ip": "./dist/cli.js" },
  "scripts": {
    "build": "tspp -p tsppconfig.json --pretty false",
    "check": "pnpm --filter @tspp/command-kit build && tspp -p tsppconfig.json --noEmit --pretty false",
    "test": "pnpm --filter @tspp/command-kit build && pnpm build && pnpm test:run",
    "test:run": "node --test test/*.test.cjs",
    "cli": "node dist/cli.js"
  },
  "dependencies": { "@tspp/command-kit": "workspace:*" },
  "devDependencies": { "ts-plus-plus": "workspace:*", "@types/node": "^22.20.5" }
}
