import { mkdir, readFile, writeFile } from "node:fs/promises";
import { dirname, resolve } from "node:path";
import { emitKeypressEvents, type Key } from "node:readline";
import type { ReadStream, WriteStream } from "node:tty";
import type { TaskDefinition, TaskTable } from "./model.js";

export data class TaskCandidate(name: string, value: string, description: string, summary: string)

export function describeTask(name: string, task: TaskDefinition, commandName = "task"): string {
  const lines = [task.details ?? task.description];
  lines.push(`Dependencies: ${(task.dependencies ?? []).join(", ") || "none"} (${task.dependencyMode ?? "serial"})`);
  if (task.envFile) lines.push(`Environment: ${task.envFile}`);
  if (task.forwardArgs) lines.push("Accepts task arguments after --");
  if (task.prepare) lines.push("Collects options before any commands; --prepare-only previews the prepared result");
  lines.push(`Run: ${commandName} ${name}`);
  return lines.join("\n");
}

export function taskCandidates(tasks: TaskTable, includeInternal = false): readonly TaskCandidate[] do {
  Object.entries(tasks).filter(([, task]) => includeInternal || task.public !== false)
    .map(([name, task]) => new TaskCandidate(`${name}: ${task.description}`, name, describeTask(name, task), task.description));
}

function normalize(text: string): string do { text.toLowerCase().replace(/[^\p{L}\p{N}]/gu, ""); }

/** Conservative terminal-cell clipping for Latin, combining marks, CJK and emoji. */
function clip(text: string, width: number): string {
  let result = "";
  let used = 0;
  for (const character of text) {
    const code = character.codePointAt(0) ?? 0;
    const cells = /\p{Mark}/u.test(character) || code === 0x200d || code === 0xfe0f ? 0
      : code >= 0x1100 && (code <= 0x115f || code >= 0x2329 && code <= 0x232a || code >= 0x2e80 && code <= 0xa4cf || code >= 0xac00 && code <= 0xd7a3 || code >= 0xf900 && code <= 0xfaff || code >= 0xfe10 && code <= 0xfe6f || code >= 0xff00 && code <= 0xff60 || code >= 0xffe0 && code <= 0xffe6 || code >= 0x1f000) ? 2 : 1;
    if (used + cells > width) break;
    result += character;
    used += cells;
  }
  return result;
}
function score(candidate: TaskCandidate, keyword: string): number {
  const word = keyword.toLowerCase();
  const name = candidate.value.toLowerCase();
  const compactWord = normalize(word);
  const compactName = normalize(name);
  if (name === word) return 1000;
  if (name.startsWith(word)) return 600;
  if (name.includes(word)) return 400;
  if (compactWord && compactName.includes(compactWord)) return compactName.startsWith(compactWord) ? 360 : 300;
  const initials = name.split(/[:\-_/]+/).filter(Boolean).map(part => part[0]).join("");
  if (compactWord.length >= 2 && initials.startsWith(compactWord)) return initials === compactWord ? 260 : 220;
  let offset = 0;
  let first = -1;
  let last = -1;
  for (const character of compactWord) {
    const found = compactName.indexOf(character, offset);
    if (found < 0) { first = -1; break; }
    if (first < 0) first = found;
    last = found;
    offset = found + 1;
  }
  if (compactWord && first >= 0) return 150 + Math.round(compactWord.length / (last - first + 1) * 100);
  const description = `${candidate.summary} ${candidate.description}`.toLowerCase();
  if (description.includes(word)) return 80;
  return compactWord && normalize(description).includes(compactWord) ? 60 : 0;
}

export function searchTasks(candidates: readonly TaskCandidate[], input = "", lastTask?: string): TaskCandidate[] {
  const words = input.trim().split(/\s+/).filter(Boolean);
  if (!words.length) return [...candidates].sort((a, b) => Number(b.value === lastTask) - Number(a.value === lastTask));
  return candidates.map(candidate => {
    const scores = words.map(word => score(candidate, word));
    return { candidate, score: scores.some(value => value === 0) ? 0 : scores.reduce((a, b) => a + b, 0) + (candidate.value === lastTask ? 15 : 0) };
  }).filter(entry => entry.score > 0).sort((a, b) => b.score - a.score).map(entry => entry.candidate);
}

export function defaultCacheFile(rootDir: string): string do { resolve(rootDir, "node_modules/.cache/task-kit/selection.json"); }
export async function readLastTask(file: string): Promise<string | undefined> {
  try {
    const value: unknown = JSON.parse(await readFile(file, "utf8"));
    if (typeof value === "object" && value !== null && "lastTask" in value && typeof value.lastTask === "string" && value.lastTask.trim()) return value.lastTask.trim();
  } catch { /* Selection history is best effort. */ }
  return undefined;
}
export async function saveLastTask(file: string, taskName: string): Promise<void> {
  try {
    await mkdir(dirname(file), { recursive: true });
    await writeFile(file, JSON.stringify({ lastTask: taskName, updatedAt: new Date().toISOString() }, null, 2), "utf8");
  } catch { /* An unavailable cache must never prevent a task from running. */ }
}

export interface TaskSelectionOptions {
  readonly candidates: readonly TaskCandidate[];
  readonly lastTask?: string;
  readonly signal?: AbortSignal;
  readonly input?: ReadStream;
  readonly output?: WriteStream;
}

/** Search as you type; arrows/page keys select, Enter confirms, Escape/Ctrl-C cancels. */
export async function selectTask(options: TaskSelectionOptions): Promise<string | undefined> {
  const input = options.input ?? process.stdin;
  const output = options.output ?? process.stdout;
  if (!input.isTTY || !output.isTTY) throw new Error("Non-interactive sessions must specify a task name; use --list to see available tasks");
  if (!options.candidates.length) throw new Error("No public tasks are available");
  options.signal?.throwIfAborted();
  return new Promise((resolve, reject) => {
    let query = "";
    let selected = 0;
    let displayed = 0;
    let matches = searchTasks(options.candidates, query, options.lastTask);
    const wasRaw = input.isRaw;
    const wasFlowing = input.readableFlowing === true;
    let settled = false;
    const clear = (): void => {
      if (displayed) output.write(`\u001b[${displayed}A\r\u001b[0J`);
      displayed = 0;
    };
    const draw = (): void => {
      clear();
      const first = Math.floor(selected / 15) * 15;
      const chosen = matches[selected];
      const lines = [`Search tasks: ${query}`, "Type to filter | ↑/↓ select | Enter run | Esc cancel"];
      for (const [index, item] of matches.slice(first, first + 15).entries()) lines.push(`${index + first === selected ? ">" : " "} ${item.name}${item.value === options.lastTask ? " (last selected)" : ""}`);
      if (!matches.length) lines.push("No matches");
      if (chosen) lines.push("", ...chosen.description.split("\n"));
      // Keep terminal wrapping from invalidating cursor movement while cleaning up.
      const width = Math.max(1, (output.columns || 80) - 1);
      const visible = lines.slice(0, Math.max(3, (output.rows || 40) - 1)).map(line => clip(line, width));
      output.write(visible.join("\n") + "\n");
      displayed = visible.length;
    };
    const finish = (value?: string, error?: unknown): void => {
      if (settled) return;
      settled = true;
      input.off("keypress", keypress);
      input.off("end", ended);
      options.signal?.removeEventListener("abort", aborted);
      input.setRawMode(wasRaw);
      if (!wasFlowing) input.pause();
      clear(); output.write("\u001b[?25h");
      if (error !== undefined) reject(error); else resolve(value);
    };
    const aborted = (): void => finish(undefined, options.signal?.reason ?? new Error("Task selection aborted"));
    const ended = (): void => finish();
    const keypress = (text: string | undefined, key: Key): void => {
      if (key.name === "escape" || (key.ctrl && key.name === "c")) { finish(); return; }
      if (key.name === "return") { if (matches[selected]) finish(matches[selected].value); return; }
      if (key.name === "up") selected = Math.max(0, selected - 1);
      else if (key.name === "down") selected = Math.min(matches.length - 1, selected + 1);
      else if (key.name === "pageup") selected = Math.max(0, selected - 15);
      else if (key.name === "pagedown") selected = Math.min(matches.length - 1, selected + 15);
      else if (key.name === "backspace") { query = [...query].slice(0, -1).join(""); selected = 0; }
      else if (text && !key.ctrl && !key.meta && !/[\x00-\x1f\x7f]/.test(text)) { query += text; selected = 0; }
      matches = searchTasks(options.candidates, query, options.lastTask);
      selected = Math.max(0, Math.min(selected, matches.length - 1));
      draw();
    };
    emitKeypressEvents(input);
    input.setRawMode(true);
    input.resume();
    input.on("keypress", keypress);
    input.once("end", ended);
    options.signal?.addEventListener("abort", aborted, { once: true });
    output.write("\u001b[?25l");
    draw();
  });
}
