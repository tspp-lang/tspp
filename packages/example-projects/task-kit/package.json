{
  "name": "@tspp/task-kit",
  "version": "0.0.0",
  "private": true,
  "description": "A prepared task graph runner and searchable CLI written in TS++.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "tsppTypes": "./dist/index.d.tspp",
  "exports": { ".": { "tspp-types": "./dist/index.d.tspp", "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tspp --compile -p tsppconfig.json --pretty false",
    "check": "tspp --compile -p tsppconfig.json --noEmit --pretty false",
    "test": "pnpm build && pnpm test:run",
    "test:run": "node --test test/*.test.cjs"
  },
  "dependencies": { "@tspp/command-kit": "workspace:*", "cross-spawn": "^7.0.6" },
  "devDependencies": { "ts-plus-plus": "workspace:*", "@types/node": "^22.20.5", "@types/cross-spawn": "^6.0.6" }
}
