import * as fs from "node:fs";
import * as path from "node:path";
import { randomUUID } from "node:crypto";
import { emptyLedger, validateLedger, type LedgerState } from "./domain.js";

export effect LedgerStorage {
  load(): LedgerState;
  save(state: LedgerState): void;
}

export function loadLedger() / LedgerStorage: LedgerState {
  return validateLedger(perform LedgerStorage.load());
}
export function commitLedger(state: LedgerState) / LedgerStorage: LedgerState {
  const checked = validateLedger(state);
  perform LedgerStorage.save(checked);
  return checked;
}

export interface Storage {
  load(): LedgerState;
  save(state: LedgerState): void;
  close(): void;
}

export function memoryStorage(initial: LedgerState = emptyLedger()): Storage {
  let state = validateLedger(initial);
  return {
    load: () => validateLedger(JSON.parse(JSON.stringify(state))),
    save: next => { state = validateLedger(JSON.parse(JSON.stringify(next))); },
    close: () => {},
  };
}

export function fileStorage(filePath: string): Storage {
  const target = path.resolve(filePath);
  fs.mkdirSync(path.dirname(target), { recursive: true });
  const lockPath = `${target}.lock`;
  const lock = fs.openSync(lockPath, "wx", 0o600);
  let closed = false;
  const ensureOpen = () => { if (closed) throw new Error("Storage is closed"); };
  return {
    load: () => {
      ensureOpen();
      if (!fs.existsSync(target)) return emptyLedger();
      return validateLedger(JSON.parse(fs.readFileSync(target, "utf8")));
    },
    save: state => {
      ensureOpen();
      const checked = validateLedger(state);
      const temporary = `${target}.${randomUUID()}.tmp`;
      let fd: number | undefined;
      try {
        fd = fs.openSync(temporary, "wx", 0o600);
        fs.writeFileSync(fd, `${JSON.stringify(checked, null, 2)}\n`, "utf8");
        fs.fsyncSync(fd);
        fs.closeSync(fd);
        fd = undefined;
        fs.renameSync(temporary, target);
      } finally {
        if (fd !== undefined) fs.closeSync(fd);
        if (fs.existsSync(temporary)) fs.unlinkSync(temporary);
      }
    },
    close: () => {
      if (closed) return;
      closed = true;
      fs.closeSync(lock);
      fs.unlinkSync(lockPath);
    },
  };
}

export function readStored(storage: Storage): LedgerState {
  return handle LedgerStorage { load: () => storage.load(), save: state => storage.save(state) } in { loadLedger(); };
}
export function writeStored(storage: Storage, state: LedgerState): LedgerState {
  return handle LedgerStorage { load: () => storage.load(), save: next => storage.save(next) } in { commitLedger(state); };
}
