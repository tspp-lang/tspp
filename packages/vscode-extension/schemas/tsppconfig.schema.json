                "dynamicprioritypolling",
                "fixedchunksizepolling"
              ]
            },
            {
              "pattern": "^(?:[uU][sS][eE][fF][sS][eE][vV][eE][nN][tT][sS]|[fF][iI][xX][eE][dD][pP][oO][lL][lL][iI][nN][gG][iI][nN][tT][eE][rR][vV][aA][lL]|[dD][yY][nN][aA][mM][iI][cC][pP][rR][iI][oO][rR][iI][tT][yY][pP][oO][lL][lL][iI][nN][gG]|[fF][iI][xX][eE][dD][cC][hH][uU][nN][kK][sS][iI][zZ][eE][pP][oO][lL][lL][iI][nN][gG])$"
