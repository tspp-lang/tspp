{
  "name": "tspp-vscode",
  "displayName": "TS++",
  "description": "TS++ language support powered by the TSPP language server.",
  "version": "0.0.1",
  "publisher": "tspp-lang",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tspp-lang/tspp.git",
    "directory": "packages/vscode-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:tspp"
  ],
  "main": "./extension.js",
  "scripts": {
    "build": "node scripts/build-plugin-grammar.mjs && node --check extension.js",
    "lint": "eslint extension.js scripts",
    "test": "node --check extension.js && node scripts/build-plugin-grammar.mjs --check"
  },
  "dependencies": {
    "@tspp/plugin-sdk": "workspace:*",
    "ts-plus-plus": "workspace:*",
    "tspp-language-server": "workspace:*",
    "@tspp/plugin-advanced-classes": "workspace:*",
    "@tspp/plugin-formal-verification": "workspace:*",
    "@tspp/plugin-macros": "workspace:*",
    "@tspp/plugin-modern-syntax": "workspace:*",
    "@tspp/plugin-nominal-types": "workspace:*",
    "@tspp/plugin-operator-sections": "workspace:*",
    "@tspp/plugin-static-interface-members": "workspace:*",
    "@tspp/plugin-type-computation": "workspace:*",
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "tspp",
        "aliases": [
          "TS++",
          "TSPP"
        ],
        "extensions": [
          ".tspp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tspp",
        "scopeName": "source.tspp",
        "path": "./syntaxes/tspp.tmLanguage.json"
      },
      {
        "scopeName": "source.tspp.plugins",
        "path": "./syntaxes/tspp-plugins.tmLanguage.json",
        "injectTo": ["source.tspp"]
      }
    ],
    "commands": [
      {
        "command": "tspp.restartLanguageServer",
        "title": "TS++: Restart Language Server"
      },
      {
        "command": "tspp.openLanguageServerLog",
        "title": "TS++: Open Language Server Log"
      },
      {
        "command": "tspp.showExpandedSource",
        "title": "TS++: Show Macro Expansion",
        "icon": "$(preview)"
      },
      {
        "command": "tspp.showAnalysisArtifacts",
        "title": "TS++: Show Analysis Artifacts",
        "icon": "$(symbol-operator)"
      },
      {
        "command": "tspp.showSmtSource",
        "title": "TS++: Show SMT Source"
      },
      {
        "command": "tspp.showMlttNormalForms",
        "title": "TS++: Show MLTT Normal Forms"
      },
      {
        "command": "tspp.showProjectedSource",
        "title": "TS++: Show Projected TypeScript",
        "icon": "$(code)"
      },
      {
        "command": "tspp.showActivePlugins",
        "title": "TS++: Show Active Feature Capsules"
      }
    ],
    "menus": {
      "editor/title": [
        { "command": "tspp.showExpandedSource", "when": "editorLangId == tspp && resourceExtname == .tspp", "group": "navigation@10" },
        { "command": "tspp.showAnalysisArtifacts", "when": "editorLangId == tspp && resourceExtname == .tspp", "group": "navigation@11" },
        { "command": "tspp.showProjectedSource", "when": "editorLangId == tspp && resourceExtname == .tspp", "group": "navigation@12" }
      ]
    },
    "configuration": {
      "title": "TS++",
      "properties": {
        "tspp.sdkPath": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Path to a TSPP SDK root containing lib/tsserver.js, its lib directory, or tsserver.js itself. Relative paths are resolved from the first workspace folder."
        }
      }
    }
  }
}
