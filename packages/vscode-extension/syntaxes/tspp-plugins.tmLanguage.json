{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TS++ plugin contributions",
  "scopeName": "source.tspp.plugins",
  "injectionSelector": "L:source.tspp -comment -string, L:meta.template.expression -comment -string.quoted",
  "patterns": [
    {
      "comment": "data class Name(params) — full primary-constructor declaration up to end of line or semicolon or body",
      "begin": "(?<![.\\w$])(data)(?![\\w$])\\s+(class)(?![\\w$])\\s+([A-Za-z_$][\\w$]*)",
      "beginCaptures": {
        "1": {
          "name": "storage.modifier.data.tspp"
        },
        "2": {
          "name": "storage.type.class.ts"
        },
        "3": {
          "name": "entity.name.type.class.ts"
        }
      },
      "end": "(?=$|;|\\{)",
      "name": "meta.declaration.class.data.tspp",
      "patterns": [
        {
          "begin": "(\\()",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.parameters.begin.ts"
            }
          },
          "end": "(\\))",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.parameters.end.ts"
            }
          },
          "patterns": [
            {
              "match": "\\b(val|var|readonly)\\b",
              "name": "storage.modifier.ts"
            },
            {
              "match": "([A-Za-z_$][\\w$]*)\\s*(?=[:,)]|$)",
              "captures": {
                "1": {
                  "name": "variable.parameter.ts"
                }
              }
            },
            {
              "include": "source.ts#type-annotation"
            },
            {
              "include": "source.ts#punctuation-comma"
            },
            {
              "include": "source.ts"
            }
          ]
        }
      ]
    },
    {
      "comment": "object Name { ... } — singleton object declaration and body",
      "begin": "(?<![.\\w$])(object)(?![\\w$])\\s+([A-Za-z_$][\\w$]*)(?:\\s+(?:extends|implements)\\s+[^{]+)?\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.class.object.tspp"
        },
        "2": {
          "name": "entity.name.type.class.object.tspp"
        },
        "3": {
          "name": "punctuation.definition.block.ts"
        }
      },
      "end": "(\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.block.ts"
        }
      },
      "name": "meta.declaration.object.tspp",
      "patterns": [
        {
          "match": "\\b(public|private|protected|readonly|static|override|abstract|final|async)\\b",
          "name": "storage.modifier.ts"
        },
        {
          "match": "\\bfield\\b(?=\\s+[A-Za-z_$][\\w$]*)",
          "name": "storage.modifier.field.tspp"
        },
        {
          "match": "\\bfield\\b",
          "name": "variable.language.this.field.tspp"
        },
        {
          "match": "\\b([A-Za-z_$][\\w$]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.ts"
            }
          }
        },
        {
          "match": "\\b([A-Za-z_$][\\w$]*)\\s*(?=:)",
          "captures": {
            "1": {
              "name": "variable.object.property.ts"
            }
          }
        },
        {
          "include": "source.ts"
        }
      ]
    },
    {
      "comment": "object Name header without same-line brace",
      "match": "(?<![.\\w$])(object)(?![\\w$])\\s+([A-Za-z_$][\\w$]*)",
      "captures": {
        "1": {
          "name": "storage.type.class.object.tspp"
        },
        "2": {
          "name": "entity.name.type.class.object.tspp"
        }
      }
    },
    {
      "match": "(?<![.\\w$])object(?![\\w$])(?=\\s+[A-Za-z_$][\\w$]*|$|\\))",
      "name": "storage.type.class.object.tspp"
    },
    {
      "match": "(?<![.\\w$])final(?![\\w$])(?=\\s+(?:class|abstract|data|sealed|public|private|protected|static|readonly|override|async|field|[A-Za-z_$][\\w$]*)|$|\\))",
      "name": "storage.modifier.final.tspp"
    },
    {
      "match": "(?<![.\\w$])sealed(?![\\w$])(?=\\s+(?:class|abstract|data|final|[A-Za-z_$][\\w$]*)|$|\\))",
      "name": "storage.modifier.sealed.tspp"
    },
    {
      "match": "(?<![.\\w$])data(?![\\w$])(?=\\s+(?:class|abstract|final|sealed\\b)|$|\\))",
      "name": "storage.modifier.data.tspp"
    },
    {
      "match": "(?<![.\\w$])with(?![\\w$])(?=\\s*\\()",
      "name": "keyword.control.with.tspp"
    },
    {
      "match": "(?<![.\\w$])field(?![\\w$])(?=\\s+[A-Za-z_$][\\w$]*)",
      "name": "storage.modifier.field.tspp"
    },
    {
      "match": "(?<![.\\w$])field(?![\\w$])(?!\\s*:)",
      "name": "variable.language.this.field.tspp"
    },
    {
      "match": "\\b(assert|assume)(?=\\s*:)",
      "name": "keyword.control.verification.tspp"
    },
    {
      "match": "\\bwith(?=\\s*\\{)",
      "name": "keyword.control.contract.tspp"
    },
    {
      "match": "\\b(requires|ensures|invariant|predicate|numberModel)(?=\\s*:)",
      "name": "keyword.control.verification.tspp"
    },
    {
      "match": "\\bresult\\b",
      "name": "variable.language.contract-result.tspp"
    },
    {
      "match": "\\b(definePredicate|defineFunction|defineRecursiveFunction|declareFunction|axiom|forall|exists|implies|apply)\\b",
      "name": "support.function.smt.tspp"
    },
    {
      "match": "\\b(Bool|Int|Real|String)\\b",
      "name": "support.type.smt-sort.tspp"
    },
    {
      "match": "^(\\s*)(?:(export)(\\s+))?(?:(default)(\\s+))?(?:(declare)(\\s+))?(?:(async)(\\s+))?(macro)(?=\\s+function\\b|\\s*\\(.*\\)\\s*function\\b)",
      "captures": {
        "2": {
          "name": "keyword.control.export.ts"
        },
        "4": {
          "name": "storage.modifier.ts"
        },
        "6": {
          "name": "storage.modifier.ts"
        },
        "8": {
          "name": "storage.modifier.async.ts"
        },
        "10": {
          "name": "keyword.control.macro.tspp"
        }
      }
    },
    {
      "match": "^\\s*(macro)(?=\\s+[A-Za-z_$][\\w$]*(?:\\s*\\.\\s*[A-Za-z_$][\\w$]*)*\\s*\\()",
      "captures": {
        "1": {
          "name": "keyword.control.macro.tspp"
        }
      }
    },
    {
      "comment": "A `do` block holds statements wherever it stands, where TypeScript would expect an object literal after `=`.",
      "begin": "(?<![.\\w$])(do)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.do.tspp"
        },
        "2": {
          "name": "punctuation.definition.block.ts"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.ts"
        }
      },
      "patterns": [
        {
          "include": "source.ts#statements"
        }
      ]
    },
    {
      "comment": "`let name = value in body`, on one line or after an `=`, in values and in types. A plain `let` is TypeScript's.",
      "begin": "(?<![.\\w$])(?:(let)(?=\\s+(?:[A-Za-z_$][\\w$]*|\\[|\\{)[^;\\n]*\\bin\\b)|(?:(?<==)|(?<==\\s))(let)(?=\\s+[A-Za-z_$][\\w$]*\\s*(?::[^=\\n]*)?=))",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.let.tspp"
        },
        "2": {
          "name": "keyword.control.let.tspp"
        }
      },
      "end": "(?<![.\\w$])in(?![\\w$])",
      "endCaptures": {
        "0": {
          "name": "keyword.control.in.tspp"
        }
      },
      "patterns": [
        {
          "match": "(?<![.\\w$])in(?![\\w$])",
          "name": "keyword.control.in.tspp"
        },
        {
          "include": "source.ts#comment"
        },
        {
          "match": "(?<![.\\w$])([A-Za-z_$][\\w$]*)\\s*(?=(?::[^=\\n]*)?=)",
          "captures": {
            "1": {
              "name": "variable.other.constant.ts"
            }
          }
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.ts"
        },
        {
          "match": ":",
          "name": "keyword.operator.type.annotation.ts"
        },
        {
          "include": "source.ts#type"
        }
      ]
    },
    {
      "match": "\\b(use)(?=\\s+(?:[A-Za-z_$][\\w$]*|\\[|\\{)[^;\\n]*<-)",
      "name": "keyword.control.use.tspp"
    },
    {
      "comment": "`def name = value`. After `export`, TypeScript would read `name =` as an export assignment.",
      "begin": "(?<![.\\w$])(def)(?=\\s+(?:[A-Za-z_$][\\w$]*|\\[|\\{))",
      "beginCaptures": {
        "1": {
          "name": "storage.type.def.tspp"
        }
      },
      "end": "(?=;)|^(?=\\s*[^\\s.,?:+\\-*/|&=<>])",
      "patterns": [
        {
          "include": "source.ts#comment"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.ts"
        },
        {
          "include": "source.ts#expression"
        }
      ]
    },
    {
      "comment": "`data Name<T> = A | B(field: T)`. It ends at a semicolon or at a line that does not continue it.",
      "begin": "(?<![.\\w$])(data)\\s+([A-Za-z_$][\\w$]*)(?=\\s*(?:<|=|$))",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.nominal-types.tspp"
        },
        "2": {
          "name": "entity.name.type.tspp"
        }
      },
      "end": "(?=;)|^(?=\\s*[^\\s|=</])",
      "patterns": [
        {
          "include": "source.ts#comment"
        },
        {
          "include": "source.ts#type-parameters"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.ts"
        },
        {
          "match": "\\|",
          "name": "keyword.operator.type.ts"
        },
        {
          "begin": "([A-Za-z_$][\\w$]*)\\s*(\\()",
          "beginCaptures": {
            "1": {
              "name": "entity.name.function.tspp"
            },
            "2": {
              "name": "meta.brace.round.ts"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "meta.brace.round.ts"
            }
          },
          "patterns": [
            {
              "include": "source.ts#comment"
            },
            {
              "match": "([A-Za-z_$][\\w$]*)\\s*(?=:)",
              "captures": {
                "1": {
                  "name": "variable.object.property.ts"
                }
              }
            },
            {
              "match": ":",
              "name": "keyword.operator.type.annotation.ts"
            },
            {
              "include": "source.ts#punctuation-comma"
            },
            {
              "include": "source.ts#type"
            }
          ]
        },
        {
          "match": "[A-Za-z_$][\\w$]*",
          "name": "entity.name.function.tspp"
        }
      ]
    },
    {
      "comment": "`newtype Name<T> = Type`.",
      "begin": "(?<![.\\w$])(newtype)\\s+([A-Za-z_$][\\w$]*)(?=\\s*(?:<|=|$))",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.nominal-types.tspp"
        },
        "2": {
          "name": "entity.name.type.tspp"
        }
      },
      "end": "(?=;)|^(?=\\s*[^\\s|=</&])",
      "patterns": [
        {
          "include": "source.ts#comment"
        },
        {
          "include": "source.ts#type-parameters"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.ts"
        },
        {
          "include": "source.ts#type"
        }
      ]
    },
    {
      "comment": "`match scrutinee { arms }`: the arms are not an object literal, and no TypeScript state may outlive them.",
      "begin": "(?<![.\\w$])(match)(?![\\w$])(?=[^;{\\n]*\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.match.tspp"
        }
      },
      "end": "(?<=\\})",
      "patterns": [
        {
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.block.ts"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.block.ts"
            }
          },
          "patterns": [
            {
              "include": "source.ts#comment"
            },
            {
              "match": "(?<![.\\w$])(?:true|false|null|undefined)(?=\\s*(?:=>|:))",
              "name": "constant.language.ts"
            },
            {
              "match": "(?<![.\\w$])(?:string|number|bigint|boolean|symbol|object|unknown|never|any|void)(?=\\s*:)",
              "name": "support.type.primitive.ts"
            },
            {
              "match": "(?<![.\\w$])([A-Za-z_$][\\w$]*)(?=\\s*(?:=>|:|\\bif\\b))",
              "captures": {
                "1": {
                  "name": "variable.other.readwrite.ts"
                }
              }
            },
            {
              "match": "=>",
              "name": "storage.type.function.arrow.ts"
            },
            {
              "match": "(?<![.\\w$])if(?![\\w$])",
              "name": "keyword.control.conditional.ts"
            },
            {
              "include": "source.ts#punctuation-comma"
            },
            {
              "include": "source.ts#expression"
            }
          ]
        },
        {
          "include": "source.ts#expression"
        }
      ]
    },
    {
      "name": "variable.language.placeholder.tspp",
      "match": "(?<![._$[:alnum:]])_(?![_$[:alnum:]])"
    },
    {
      "name": "meta.embedded.inline.tspp-operator keyword.operator.comparison.ts",
      "match": "===|!==|==|!=|<=|>="
    },
    {
      "name": "keyword.operator.comparison.ts",
      "match": "(?<=\\b_\\s*)[<>](?=\\s*[^>])|(?<=[^<]\\s*)[<>](?=\\s*_\\b)"
    },
    {
      "match": "\\bstatic\\b",
      "name": "storage.modifier.static.tspp"
    },
    {
      "comment": "`let name = value in body`, on one line or after an `=`, in values and in types. A plain `let` is TypeScript's.",
      "begin": "(?<![.\\w$])(?:(let)(?=\\s+(?:[A-Za-z_$][\\w$]*|\\[|\\{)[^;\\n]*\\bin\\b)|(?:(?<==)|(?<==\\s))(let)(?=\\s+[A-Za-z_$][\\w$]*\\s*(?::[^=\\n]*)?=))",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.let.tspp"
        },
        "2": {
          "name": "keyword.control.let.tspp"
        }
      },
      "end": "(?<![.\\w$])in(?![\\w$])",
      "endCaptures": {
        "0": {
          "name": "keyword.control.in.tspp"
        }
      },
      "patterns": [
        {
          "match": "(?<![.\\w$])in(?![\\w$])",
          "name": "keyword.control.in.tspp"
        },
        {
          "include": "source.ts#comment"
        },
        {
          "match": "(?<![.\\w$])([A-Za-z_$][\\w$]*)\\s*(?=(?::[^=\\n]*)?=)",
          "captures": {
            "1": {
              "name": "variable.other.constant.ts"
            }
          }
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.ts"
        },
        {
          "match": ":",
          "name": "keyword.operator.type.annotation.ts"
        },
        {
          "include": "source.ts#type"
        }
      ]
    },
    {
      "comment": "`match scrutinee { arms }`: the arms are not an object literal, and no TypeScript state may outlive them.",
      "begin": "(?<![.\\w$])(match)(?![\\w$])(?=[^;{\\n]*\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.match.tspp"
        }
      },
      "end": "(?<=\\})",
      "patterns": [
        {
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.block.ts"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.block.ts"
            }
          },
          "patterns": [
            {
              "include": "source.ts#comment"
            },
            {
              "match": "(?<![.\\w$])(?:true|false|null|undefined)(?=\\s*(?:=>|:))",
              "name": "constant.language.ts"
            },
            {
              "match": "(?<![.\\w$])(?:string|number|bigint|boolean|symbol|object|unknown|never|any|void)(?=\\s*:)",
              "name": "support.type.primitive.ts"
            },
            {
              "match": "(?<![.\\w$])([A-Za-z_$][\\w$]*)(?=\\s*(?:=>|:|\\bif\\b))",
              "captures": {
                "1": {
                  "name": "variable.other.readwrite.ts"
                }
              }
            },
            {
              "match": "=>",
              "name": "storage.type.function.arrow.ts"
            },
            {
              "match": "(?<![.\\w$])if(?![\\w$])",
              "name": "keyword.control.conditional.ts"
            },
            {
              "include": "source.ts#punctuation-comma"
            },
            {
              "include": "source.ts#expression"
            }
          ]
        },
        {
          "include": "source.ts#expression"
        }
      ]
    },
    {
      "match": "(?:(?<=\\.\\.\\.)|(?<![.\\w$]))infer(?=\\s+[A-Za-z_$])",
      "name": "keyword.operator.expression.infer.ts"
    },
    {
      "match": "=>>",
      "name": "keyword.operator.type-constructor.tspp"
    },
    {
      "match": "\\bType(?:0|[1-9]\\d*)?\\b",
      "name": "support.type.universe.tspp"
    },
    {
      "comment": "`typecase scrutinee { arms }`: the arms are not an object literal, and no TypeScript state may outlive them.",
      "begin": "(?<![.\\w$])(typecase)(?![\\w$])(?=[^;{\\n]*\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.mltt.tspp"
        }
      },
      "end": "(?<=\\})",
      "patterns": [
        {
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.block.ts"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.block.ts"
            }
          },
          "patterns": [
            {
              "include": "source.ts#comment"
            },
            {
              "match": "(?<![.\\w$])(?:true|false|null|undefined)(?=\\s*(?:=>|:))",
              "name": "constant.language.ts"
            },
            {
              "match": "(?<![.\\w$])(?:string|number|bigint|boolean|symbol|object|unknown|never|any|void)(?=\\s*:)",
              "name": "support.type.primitive.ts"
            },
            {
              "match": "(?<![.\\w$])([A-Za-z_$][\\w$]*)(?=\\s*(?:=>|:|\\bif\\b))",
              "captures": {
                "1": {
                  "name": "variable.other.readwrite.ts"
                }
              }
            },
            {
              "match": "=>",
              "name": "storage.type.function.arrow.ts"
            },
            {
              "match": "(?<![.\\w$])if(?![\\w$])",
              "name": "keyword.control.conditional.ts"
            },
            {
              "include": "source.ts#punctuation-comma"
            },
            {
              "include": "source.ts#expression"
            }
          ]
        },
        {
          "include": "source.ts#expression"
        }
      ]
    },
    {
      "match": "\\bType(?:0|[1-9]\\d*)?\\b",
      "name": "support.type.universe.tspp"
    },
    {
      "match": "\\b(?:Bool|True|False|BoolElim|If|Nat|Zero|Succ|NatAdd|NatElim|Eq|Refl|J|Sigma|Pair|First|Second|Lam|Ann)\\b",
      "name": "support.type.mltt.tspp"
    },
    {
      "match": "\\b(?:reify|auto)\\b",
      "name": "keyword.control.mltt.tspp"
    },
    {
      "match": "->",
      "name": "keyword.operator.dependent-function.tspp"
    },
    {
      "name": "keyword.declaration.typeclass.tspp",
      "match": "(?<![._$[:alnum:]])(typeclass|impl)(?=\\s+[_$[:alpha:]]|<)"
    },
    {
      "name": "keyword.other.where.tspp",
      "match": "(?<![._$[:alnum:]])where(?=\\s*<)"
    }
  ]
}
