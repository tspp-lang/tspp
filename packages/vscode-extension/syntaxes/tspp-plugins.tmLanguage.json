{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TS++ plugin contributions",
  "scopeName": "source.tspp.plugins",
  "injectionSelector": "L:source.tspp",
  "patterns": [
    {
      "match": "\\bType(?:0|[1-9]\\d*)?\\b",
      "name": "support.type.universe.tspp"
    },
    {
      "match": "\\b(?:Bool|True|False|BoolElim|If|Nat|Zero|Succ|NatAdd|NatElim|Eq|Refl|J|Sigma|Pair|First|Second|Lam|Ann)\\b",
      "name": "support.type.mltt.tspp"
    },
    {
      "match": "\\b(?:reify|typecase)\\b",
      "name": "keyword.control.mltt.tspp"
    },
    {
      "match": "->",
      "name": "keyword.operator.dependent-function.tspp"
    },
    {
      "match": "\\b(assert|assume)(?=\\s*:)",
      "name": "keyword.control.verification.tspp"
    },
    {
      "match": "\\bwith(?=\\s*\\{)",
      "name": "keyword.control.contract.tspp"
    },
    {
      "match": "\\b(requires|ensures|invariant|predicate|numberModel)(?=\\s*:)",
      "name": "support.type.contract-property.tspp"
    },
    {
      "match": "\\bresult\\b",
      "name": "variable.language.contract-result.tspp"
    },
    {
      "match": "\\b(definePredicate|defineFunction|defineRecursiveFunction|declareFunction|axiom|forall|exists|implies|apply)\\b",
      "name": "support.function.smt.tspp"
    },
    {
      "match": "\\b(Bool|Int|Real|String)\\b",
      "name": "support.type.smt-sort.tspp"
    },
    {
      "match": "^(\\s*)(?:(export)(\\s+))?(?:(default)(\\s+))?(?:(declare)(\\s+))?(?:(async)(\\s+))?(macro)(\\s+)(?=function\\b)",
      "captures": {
        "2": {
          "name": "keyword.control.export.ts"
        },
        "4": {
          "name": "storage.modifier.ts"
        },
        "6": {
          "name": "storage.modifier.ts"
        },
        "8": {
          "name": "storage.modifier.async.ts"
        },
        "10": {
          "name": "keyword.control.macro.tspp"
        }
      }
    },
    {
      "match": "^\\s*(macro)(?=\\s+[A-Za-z_$][\\w$]*(?:\\s*\\.\\s*[A-Za-z_$][\\w$]*)*\\s*\\()",
      "captures": {
        "1": {
          "name": "keyword.control.macro.tspp"
        }
      }
    },
    {
      "match": "\\b(with)\\b(?=\\s*\\{)",
      "captures": {
        "1": {
          "name": "keyword.control.with.tspp"
        }
      }
    },
    {
      "match": "\\b(let)(?=\\s+(?:[A-Za-z_$][\\w$]*|\\[|\\{)[^;\\n]*\\bin\\b)",
      "name": "keyword.control.let.tspp"
    },
    {
      "match": "\\b(do)(?=\\s*\\{)",
      "name": "keyword.control.do.tspp"
    },
    {
      "match": "\\b(use)(?=\\s+(?:[A-Za-z_$][\\w$]*|\\[|\\{)[^;\\n]*<-)",
      "name": "keyword.control.use.tspp"
    },
    {
      "match": "\\b(def)(?=\\s+(?:[A-Za-z_$][\\w$]*|\\[|\\{))",
      "name": "storage.type.def.tspp"
    },
    {
      "match": "\\b(?:newtype|data)\\b",
      "name": "keyword.declaration.nominal-types.tspp"
    },
    {
      "match": "\\bmatch\\b",
      "name": "keyword.control.match.tspp"
    },
    {
      "name": "variable.language.placeholder.tspp",
      "match": "(?<![._$[:alnum:]])_(?![_$[:alnum:]])"
    },
    {
      "name": "meta.embedded.inline.tspp-operator keyword.operator.comparison.ts",
      "match": "===|!==|==|!=|<=|>="
    },
    {
      "name": "keyword.operator.comparison.ts",
      "match": "(?<=\\b_\\s*)[<>](?=\\s*[^>])|(?<=[^<]\\s*)[<>](?=\\s*_\\b)"
    },
    {
      "match": "\\bstatic\\b",
      "name": "storage.modifier.static.tspp"
    },
    {
      "match": "\\b(let|in|match|infer)\\b",
      "name": "keyword.control.type-computation.tspp"
    },
    {
      "match": "=>>",
      "name": "keyword.operator.type-constructor.tspp"
    },
    {
      "match": "\\bType(?:0|[1-9][0-9]*)?\\b",
      "name": "storage.type.kind.tspp"
    },
    {
      "match": "=>",
      "name": "keyword.operator.kind.tspp"
    }
  ]
}
