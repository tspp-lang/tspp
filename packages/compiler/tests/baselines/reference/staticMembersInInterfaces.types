interface VersionedSerializable extends Serializable {
    static fromVersion(version: number): this;
>fromVersion : (version: number) => this
>            : ^       ^^      ^^^^^    
>version : number
>        : ^^^^^^
}

class GoodVersioned implements VersionedSerializable {
>GoodVersioned : GoodVersioned
>              : ^^^^^^^^^^^^^

    static readonly mediaType = "application/versioned";
>mediaType : "application/versioned"
>          : ^^^^^^^^^^^^^^^^^^^^^^^
>"application/versioned" : "application/versioned"
>                        : ^^^^^^^^^^^^^^^^^^^^^^^

    static deserialize(_text: string): GoodVersioned {
>deserialize : (_text: string) => GoodVersioned
>            : ^     ^^      ^^^^^             
>_text : string
>      : ^^^^^^

        return new GoodVersioned();
>new GoodVersioned() : GoodVersioned
>                    : ^^^^^^^^^^^^^
>GoodVersioned : typeof GoodVersioned
>              : ^^^^^^^^^^^^^^^^^^^^
    }

    static fromVersion(_version: number): GoodVersioned {
>fromVersion : (_version: number) => GoodVersioned
>            : ^        ^^      ^^^^^             
>_version : number
>         : ^^^^^^

        return new GoodVersioned();
>new GoodVersioned() : GoodVersioned
>                    : ^^^^^^^^^^^^^
>GoodVersioned : typeof GoodVersioned
>              : ^^^^^^^^^^^^^^^^^^^^
    }

    serialize(): string {
>serialize : () => string
>          : ^^^^^^      

        return "versioned";
>"versioned" : "versioned"
>            : ^^^^^^^^^^^
    }
}

class MissingInheritedStatic implements VersionedSerializable {
>MissingInheritedStatic : MissingInheritedStatic
>                       : ^^^^^^^^^^^^^^^^^^^^^^

    static fromVersion(_version: number): MissingInheritedStatic {
>fromVersion : (_version: number) => MissingInheritedStatic
>            : ^        ^^      ^^^^^                      
>_version : number
>         : ^^^^^^

        return new MissingInheritedStatic();
>new MissingInheritedStatic() : MissingInheritedStatic
>                             : ^^^^^^^^^^^^^^^^^^^^^^
>MissingInheritedStatic : typeof MissingInheritedStatic
>                       : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
    }

    serialize(): string {
>serialize : () => string
>          : ^^^^^^      

        return "missing inherited";
>"missing inherited" : "missing inherited"
>                    : ^^^^^^^^^^^^^^^^^^^
    }
}

interface MergedStaticContract {
    static first(): void;
>first : () => void
>      : ^^^^^^    
}

interface MergedStaticContract {
    static second(): void;
>second : () => void
>       : ^^^^^^    
}

class GoodMerged implements MergedStaticContract {
>GoodMerged : GoodMerged
>           : ^^^^^^^^^^

    static first(): void {}
>first : () => void
>      : ^^^^^^    

    static second(): void {}
>second : () => void
>       : ^^^^^^    
}

declare const serializable: Serializable;
>serializable : Serializable
>             : ^^^^^^^^^^^^

serializable.deserialize("nope");
>serializable.deserialize("nope") : any
>                                 : ^^^
>serializable.deserialize : any
>                         : ^^^
>serializable : Serializable
>             : ^^^^^^^^^^^^
>deserialize : any
>            : ^^^
>"nope" : "nope"
>       : ^^^^^^

interface GenericStaticMethod {
    static identity<T>(value: T): T;
>identity : <T>(value: T) => T
>         : ^ ^^     ^^ ^^^^^ 
>value : T
>      : ^
}

class GoodGenericStaticMethod implements GenericStaticMethod {
>GoodGenericStaticMethod : GoodGenericStaticMethod
>                        : ^^^^^^^^^^^^^^^^^^^^^^^

    static identity<T>(value: T): T {
>identity : <T>(value: T) => T
>         : ^ ^^     ^^ ^^^^^ 
>value : T
>      : ^

        return value;
>value : T
>      : ^
    }
}

interface InvalidGenericStatic<T> {
    static create(value: T): InvalidGenericStatic<T>;
>create : (value: T) => InvalidGenericStatic<T>
>       : ^     ^^ ^^^^^                       
>value : T
>      : ^
}

type InvalidTypeLiteral = {
>InvalidTypeLiteral : InvalidTypeLiteral
>                   : ^^^^^^^^^^^^^^^^^^

    static create(): void;
>create : () => void
>       : ^^^^^^    

};

