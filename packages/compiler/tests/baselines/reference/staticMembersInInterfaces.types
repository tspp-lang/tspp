        return "wrong method";
>"wrong method" : "wrong method"
>               : ^^^^^^^^^^^^^^
    }
}

class MissingInstance implements Serializable {
>MissingInstance : MissingInstance
>                : ^^^^^^^^^^^^^^^

    static readonly mediaType = "application/missing-instance";
