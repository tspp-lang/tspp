=== staticMembersInInterfaces.ts ===
interface Serializable {
    static readonly mediaType: string;
>mediaType : string
>          : ^^^^^^

    static deserialize(text: string): this;
>deserialize : (text: string) => this
>            : ^    ^^      ^^^^^    
>text : string
>     : ^^^^^^

    serialize(): string;
>serialize : () => string
>          : ^^^^^^      
}

class Good implements Serializable {
>Good : Good
>     : ^^^^

    static readonly mediaType = "application/good";
>mediaType : "application/good"
>          : ^^^^^^^^^^^^^^^^^^
>"application/good" : "application/good"
>                   : ^^^^^^^^^^^^^^^^^^

    static deserialize(_text: string): Good {
>deserialize : (_text: string) => Good
>            : ^     ^^      ^^^^^    
>_text : string
>      : ^^^^^^

        return new Good();
>new Good() : Good
>           : ^^^^
>Good : typeof Good
>     : ^^^^^^^^^^^
    }

    serialize(): string {
>serialize : () => string
>          : ^^^^^^      

        return "good";
>"good" : "good"
>       : ^^^^^^
    }
}

class MissingStatic implements Serializable {
>MissingStatic : MissingStatic
>              : ^^^^^^^^^^^^^

    serialize(): string {
>serialize : () => string
>          : ^^^^^^      

        return "missing";
>"missing" : "missing"
>          : ^^^^^^^^^
    }
}

class WrongStatic implements Serializable {
>WrongStatic : WrongStatic
>            : ^^^^^^^^^^^

    static readonly mediaType = 1;
>mediaType : 1
>          : ^
>1 : 1
>  : ^

    static deserialize(_text: number): WrongStatic {
>deserialize : (_text: number) => WrongStatic
>            : ^     ^^      ^^^^^           
>_text : number
>      : ^^^^^^

        return new WrongStatic();
>new WrongStatic() : WrongStatic
>                  : ^^^^^^^^^^^
>WrongStatic : typeof WrongStatic
>            : ^^^^^^^^^^^^^^^^^^
    }

    serialize(): string {
>serialize : () => string
>          : ^^^^^^      

        return "wrong";
>"wrong" : "wrong"
>        : ^^^^^^^
    }
}

