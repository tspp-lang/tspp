{
  "name": "tspp-playground",
  "version": "0.0.0",
  "private": true,
  "description": "Browser playground for TS++: a Monaco editor backed by the compiler sources running in a web worker.",
  "type": "module",
  "scripts": {
    "diagnostics": "pnpm --filter ts-plus-plus exec hereby generate-diagnostics",
    "dev": "pnpm run diagnostics && vite",
    "build": "pnpm run diagnostics && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tspp/examples": "workspace:*",
    "lz-string": "^1.5.0",
    "monaco-editor": "^0.57.0",
    "ts-plus-plus": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
