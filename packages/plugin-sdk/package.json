{
  "name": "@tspp/plugin-sdk",
  "version": "0.0.1",
  "description": "Public contracts and host primitives for isolated TSPP compiler plugins.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tspp-lang/tspp.git",
    "directory": "packages/plugin-sdk"
  },
  "engines": {
    "node": ">=14.17"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "compiler": [
        "dist/compiler.d.ts"
      ],
      "language-service": [
        "dist/language-service.d.ts"
      ],
      "lsp": [
        "dist/lsp.d.ts"
      ],
      "editor": [
        "dist/editor.d.ts"
      ],
      "host": [
        "dist/host.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "default": "./dist/compiler.js"
    },
    "./language-service": {
      "types": "./dist/language-service.d.ts",
      "default": "./dist/language-service.js"
    },
    "./lsp": {
      "types": "./dist/lsp.d.ts",
      "default": "./dist/lsp.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "default": "./dist/editor.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "test": "pnpm build && node --test test/*.test.cjs",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "typescript": "5.9.3"
  }
}
