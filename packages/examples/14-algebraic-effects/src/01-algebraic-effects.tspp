// ============================================================================
// 14-algebraic-effects / 01-algebraic-effects.tspp
//
// 代数效应（`effect` 声明、`perform` 触发与 `handle ... in` 处理器）
//
// 什么是代数效应（Algebraic Effects）？
// 在编写函数时，函数除纯粹的数学计算外，往往还需要与外部环境交互：例如读取配置、记录日志、或者读写可变状态。
// 传统做法通常有两种极端：
//   1. 直接在函数内部硬编码全局调用（如直接调 `console.log` 或读取全局变量）—— 导致函数依赖隐式环境，难以测试和替换；
//   2. 把所有环境依赖层层作为普通参数往下传 —— 导致每一层中间函数都要被迫增加冗余参数。
//
// 代数效应通过将“函数需要执行什么外部操作（What）”与“该操作具体如何实现（How）”彻底分离，提供了第三种优雅方案：
//   - `effect`：声明一组抽象的外部能力契约（如 `Logger`、`Reader`、`State<S>`）；
//   - `/ Effect`：在函数签名末尾显式标注该函数会使用哪些效应，未处理的效应会由类型系统在编译期严格追踪；
//   - `perform`：在函数内部触发某个效应操作，无需关心它底层到底如何实现；
//   - `handle ... in`：在调用外围为效应提供具体处理逻辑（例如在生产环境打印到终端，在测试环境收集到数组中）。
// ============================================================================
// Algebraic Effects (`effect` Declarations, `perform` Operations & `handle ... in` Handlers)
//
// What are Algebraic Effects?
// Beyond pure calculation, functions often need to interact with their surrounding environment—reading configuration,
// emitting logs, or reading and updating state. Traditional code usually falls into one of two extremes:
//   1. Hardcoding global side effects inside the function — making dependencies invisible in the type signature and hard to test;
//   2. Threading context objects manually through every parameter list — cluttering intermediate functions.
//
// Algebraic effects cleanly separate *what* external operations a function performs from *how* those operations are interpreted:
//   - `effect`: Declares an abstract capability contract (such as `Logger`, `Reader`, or `State<S>`);
//   - `/ Effect`: Annotates a function signature with the effects it uses, tracked statically by the type checker;
//   - `perform`: Invokes an effect operation inside a function without coupling to a concrete implementation;
//   - `handle ... in`: Supplies the concrete interpretation for an effect around a block of code.
// ============================================================================

export {};

// ----------------------------------------------------------------------------
// 1. 定义效应（`effect`）、触发效应（`perform`）与处理效应（`handle ... in`）
//
// 写法：
//   - 定义效应：`effect <名称> { <操作名>(<参数>): <返回类型>; }`
//   - 标注函数：`function <函数名>(<参数>) / { <效应1>, <效应2> }: <返回类型>`
//   - 触发操作：`perform <效应名>.<操作名>(<实参>)`
//   - 提供处理：`handle <效应名> { <操作名>: (...) => ... } in { <代码块> }`
// ----------------------------------------------------------------------------
// 1. Declaring Effects (`effect`), Performing Operations (`perform`) & Handling (`handle ... in`)
//
// Syntax:
//   - Declare effect: `effect <Name> { <op>(<params>): <ReturnType>; }`
//   - Annotate function: `function <name>(<params>) / { <Effect1>, <Effect2> }: <ReturnType>`
//   - Perform operation: `perform <EffectName>.<op>(<args>)`
//   - Handle effect: `handle <EffectName> { <op>: (...) => ... } in { <body> }`
// ----------------------------------------------------------------------------

// 声明日志记录效应 `Logger` 与只读上下文效应 `Reader`
// Declare a logging effect `Logger` and a read-only context effect `Reader`
effect Logger {
  info(message: string): void;
}

effect Reader {
  ask(key: string): number;
}

// 函数签名末尾的 `/ { Logger, Reader }` 表明调用该函数必须处于这两个效应的处理范围内
// `/ { Logger, Reader }` after the parameter list declares that calling this function requires both effects in scope
function computeScaled(base: number) / { Logger, Reader }: number {
  const factor = perform Reader.ask("factor");
  perform Logger.info(`scale ${base} by ${factor}`);
  return base * factor;
}

const logs: string[] = [];

// 链式嵌套两个 `handle ... in`，分别为 `Reader` 和 `Logger` 提供具体实现并求值
// Chain two `handle ... in` blocks to provide concrete implementations for `Reader` and `Logger`
const scaledResult: number = handle Reader {
  ask: key => (key === "factor" ? 3 : 1),
} in handle Logger {
  info(message) {
    logs.push(message);
  },
} in {
  computeScaled(14);
};

// ----------------------------------------------------------------------------
// 2. `return` 结果转换子句与泛型效应（`State<S>`）
//
// - 在 `handle` 块中可以额外定义 `return: value => ...` 子句，对 `in { ... }` 主体算出的最终结果做统一包装转换；
// - 效应支持泛型参数（如 `State<S>`），同一套 `get` / `set` 操作可复用于任意状态类型。
// ----------------------------------------------------------------------------
// 2. The `return` Clause & Generic Effects (`State<S>`)
//
// - A `handle` block can include a `return: value => ...` clause to transform the final value produced by the `in` body;
// - Effects can be generic (like `State<S>`), allowing the same `get` / `set` operations to work with any state type.
// ----------------------------------------------------------------------------

// 使用 `return` 子句将主体计算出的数值 `2` 包装为 `{ boxed: 2 }`
// Use the `return` clause to wrap the body's result `2` into `{ boxed: 2 }`
const wrappedResult = handle Logger {
  info: () => {},
  return: value => ({ boxed: value }),
} in {
  1 + 1;
};

// 声明泛型读写状态效应 `State<S>`
// Declare a generic mutable state effect `State<S>`
effect State<S> {
  get(): S;
  set(value: S): void;
}

// 仅依赖单个效应时，`/` 后面可以省略花括号直接写 `/ State<number>`
// When a function uses a single effect, braces can be omitted after `/`: `/ State<number>`
function advance(step: number) / State<number>: number {
  const current = perform State.get();
  const next = current + step;
  perform State.set(next);
  return next;
}

let stateValue = 10;
const finalState: number = handle State<number> {
  get: () => stateValue,
  set(next) {
    stateValue = next;
  },
} in {
  advance(5);
  advance(7);
};

// ----------------------------------------------------------------------------
// 3. 闭包中的效应捕获与内层处理器拦截（Handler Shadowing）
//
// - 传给 `forEach` 等普通高阶函数的回调可以直接 `perform` 当前作用域内的效应；
// - 内层 `handle` 可以拦截同一个效应，做一层转换（如转为大写）后再 `perform` 转发给外层处理器。
// ----------------------------------------------------------------------------
// 3. Capturing Effects in Callbacks & Inner Handler Interception
//
// - Callbacks passed to standard higher-order functions like `forEach` can directly `perform` effects in scope;
// - An inner `handle` shadows the outer handler for the same effect and can `perform` to delegate to the outer handler.
// ----------------------------------------------------------------------------

function emitAll(items: string[]) / Logger: void {
  items.forEach(item => perform Logger.info(item));
}

// 内层处理器拦截 `Logger.info`，将消息转为大写后再转发给外层的 `Logger`
// The inner handler intercepts `Logger.info`, converts messages to uppercase, and forwards them to the outer `Logger`
function emitUppercase(items: string[]) / Logger: void {
  handle Logger {
    info: message => perform Logger.info(message.toUpperCase()),
  } in {
    emitAll(items);
  };
}

const upperLogs: string[] = [];
handle Logger {
  info: message => {
    upperLogs.push(message);
  },
} in {
  emitUppercase(["alpha", "beta"]);
};

console.log("[01-algebraic-effects]", {
  scaledResult,
  logs,
  wrappedResult,
  finalState,
  stateValue,
  upperLogs,
});
