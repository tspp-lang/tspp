// Effects say what a function needs; the code around it says what that means.

effect Logger {
    info(message: string): void;
}

effect Config {
    get(key: string): string;
}

effect State<S> {
    get(): S;
    set(value: S): void;
}

// A function lists its effects after the parameters. They compile to one hidden first
// parameter, and `perform` to a method call on it: no generators, no allocation per call.
function calculate(orderId: string) / { Logger, Config }: number {
    const taxRate = Number(perform Config.get("TAX_RATE"));
    perform Logger.info(`Calculating tax for ${orderId}`);
    return 100 * (1 + taxRate);
}

const lines: string[] = [];

// `handle` gives an effect its meaning for the code after `in`, whose last expression is
// the value. Handlers chain, and a function gets everything it needs from those around it.
const total = handle Config {
    get: key => key === "TAX_RATE" ? "0.08" : "",
} in handle Logger {
    info(message) {
        lines.push(message);
    },
} in {
    calculate("ORD-2026");
};

console.log(total, lines);

// The `return` clause maps the value the body finishes with.
const wrapped = handle Logger {
    info: () => {},
    return: value => ({ some: value }),
} in {
    1 + 1;
};

console.log(wrapped);

// A generic effect is typed by the instance in scope, so `perform State.get()` is a number here.
function increment(by: number) / State<number>: number {
    const value = perform State.get();
    perform State.set(value + by);
    return value + by;
}

let counter = 0;
const counted = handle State<number> {
    get: () => counter,
    set(value) {
        counter = value;
    },
} in {
    increment(2);
    increment(3);
};

console.log(counted, counter);

// A callback with no clause captures the capabilities around it, so ordinary higher-order
// functions work. It should not outlive the `handle` it uses.
function logAll(items: string[]) / Logger: void {
    items.forEach(item => perform Logger.info(item));
}

// An inner handler shadows an outer one, and a handler clause runs with the handlers around
// its `handle`, so it can add to what they do.
function shout() / Logger: void {
    handle Logger {
        info: message => perform Logger.info(message.toUpperCase()),
    } in {
        logAll(["a", "b"]);
    };
}

handle Logger {
    info: message => {
        console.log(message);
    },
} in {
    shout();
};
