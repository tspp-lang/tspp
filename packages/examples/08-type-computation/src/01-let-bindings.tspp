// ============================================================================
// 08-type-computation / 01-let-bindings.tspp
//
// 类型级局部绑定（`let ... in ...`）
//
// 在标准 TypeScript 中，如果一个复杂的类型定义内部需要多次复用同一个中间类型，通常会遇到两难：
//   1. 要么把那一长串中间类型复制粘贴好几遍，导致类型定义臃肿且难以维护；
//   2. 要么在文件顶层额外声明一堆只用一次的辅助 `type` 别名（或者用晦涩的 `T extends infer U ? ... : never` 技巧），
//      把本该局限于单个类型内部的细节泄漏到整个文件作用域。
//
// 为此，TS++ 将面向表达式的 `let <名称> = <中间类型> in <结果类型>` 直接引入到了类型层面：
// 可以在任意类型表达式内部声明仅对 `in` 右侧可见的局部类型别名，用完即止，绝不污染外部命名空间。
// ============================================================================
// Type-Level Local Bindings (`let ... in ...`)
//
// In standard TypeScript, reusing an intermediate type multiple times inside a complex type forces an awkward choice:
//   1. Duplicate the intermediate type expression everywhere it appears; or
//   2. Pollute the file scope with single-use helper `type` aliases (or resort to `T extends infer U ? ... : never` tricks).
//
// TS++ brings `let <Name> = <IntermediateType> in <ResultType>` directly into the type system:
// You can bind a local type alias inside any type expression, visible strictly within the `in` body without leaking outward.
// ============================================================================

export {};

// ----------------------------------------------------------------------------
// 1. 复用局部中间类型
//
// 写法：`let <局部类型名> = <类型定义> in <使用该名称的目标类型>`
// 效果：在 `in` 右侧可以多次引用 `<局部类型名>`，而在该类型定义外部无法访问它。
// ----------------------------------------------------------------------------
// 1. Reusing a Local Intermediate Type
//
// Syntax: `let <LocalName> = <TypeDefinition> in <TargetType>`
// Effect: `<LocalName>` can be referenced multiple times inside `<TargetType>` while remaining invisible outside.
// ----------------------------------------------------------------------------

// 定义局部类型 `Payload`，并在返回对象的 `current` 和 `backup` 两个字段中同时复用它
// Bind local type `Payload` once and reuse it in both the `current` and `backup` fields
export type Response<T> = let Payload = {
    data: T;
    status: "ok";
} in {
    current: Payload;
    backup: Payload;
};

// 验证 `Response<string>` 展开后的结构类型
// Verify the expanded object shape of `Response<string>`
const response: Response<string> = {
    current: { data: "now", status: "ok" },
    backup: { data: "then", status: "ok" },
};

// ----------------------------------------------------------------------------
// 2. 链式局部推导与同名遮蔽（Shadowing）
//
// `in` 右侧本身也可以是另一个 `let ... in ...`，从而像流水线一样分步构造复杂类型：
//   - 后一步绑定的局部类型可以直接引用前一步绑定的名字；
//   - 内层绑定如果与外层同名，会在内层作用域中自然遮蔽（Shadow）外层同名绑定。
// ----------------------------------------------------------------------------
// 2. Chained Local Pipelines & Lexical Shadowing
//
// The body after `in` can itself be another `let ... in ...`, forming a step-by-step type pipeline:
//   - Later bindings can reference earlier bindings directly;
//   - An inner binding with the same name naturally shadows the outer binding within its scope.
// ----------------------------------------------------------------------------

// 链式绑定：先算出 `Raw`，再用 `Raw` 构造 `Wrapped`，最后组合为元组 `[Raw, Wrapped]`
// Chained bindings: define `Raw` first, build `Wrapped` from `Raw`, and return the tuple `[Raw, Wrapped]`
type Normalized<T> =
    let Raw = { raw: T } in
    let Wrapped = { wrapped: Raw } in
    [Raw, Wrapped];

const normalized: Normalized<number> = [
    { raw: 42 },
    { wrapped: { raw: 42 } },
];

// 同名遮蔽：内层的 `let Value = string` 遮蔽了外层的 `let Value = number`，最终结果为 `string`
// Lexical shadowing: inner `let Value = string` shadows outer `let Value = number`, evaluating to `string`
type Shadowed = let Value = number in let Value = string in Value;
const shadowed: Shadowed = "inner";

// ----------------------------------------------------------------------------
// 3. 作用域隔离检查（`@ts-expect-error`）
//
// `let ... in` 中声明的局部类型严格受词法作用域限制，一旦离开 `in` 表达式就会立即失效。
// ----------------------------------------------------------------------------
// 3. Scope Isolation Check (`@ts-expect-error`)
//
// Local type bindings are strictly lexically scoped and cannot be referenced outside their `in` body.
// ----------------------------------------------------------------------------

// 尝试在 `Response<T>` 外部引用局部类型 `Payload` 会被编译器直接报错拦截
// Referencing the local binding `Payload` outside `Response<T>` is rejected at compile time
// @ts-expect-error A local type binding does not escape its body.
type EscapedBinding = Payload;

void response;
void normalized;
void shadowed;
