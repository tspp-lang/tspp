// The invariant must hold after the constructor and on every exit from a method, including a throw. Preconditions
// replace the runtime checks: the verifier proves them at each call instead.
class Player with {
    invariant: health >= 0;
    numberModel: "mathematical-real";
} {
    private health: number;

    public constructor(initialHealth: number) with { requires: initialHealth >= 0; } {
        this.health = initialHealth;
    }

    public takeDamage(damage: number) with { requires: damage >= 0; }: void {
        this.health = Math.max(0, this.health - damage);
    }

    public heal(amount: number) with { requires: amount > 0; }: void {
        this.health += amount;
    }

    public getHealth() with { ensures: result >= 0; }: number {
        return this.health;
    }
}

class Account with { invariant: balance >= 0n; } {
    private balance = 0n;

    deposit(amount: bigint) with { requires: amount >= 0n; }: void {
        this.balance += amount;
    }

    // A guard that throws before anything changes leaves the invariant intact.
    withdraw(amount: bigint): void {
        if (amount > this.balance) throw new Error("insufficient funds");
        this.balance -= amount;
    }
}

const hero = new Player(100);
hero.takeDamage(30);
hero.heal(10);

const account = new Account();
account.deposit(50n);
account.withdraw(20n);

console.log(hero.getHealth());
