function absolute(value: bigint) with {
    ensures: result >= 0n;
}: bigint {
    if (value >= 0n) return value;
    return -value;
}

function successor(value: bigint) with {
    requires: value >= 0n;
    ensures: result === value + 1n;
}: bigint {
    return value + 1n;
}

function addTwo(value: bigint) with {
    requires: value >= 0n;
    ensures: result === value + 2n;
}: bigint {
    return successor(successor(value));
}

console.log(absolute(-5n), addTwo(5n));
