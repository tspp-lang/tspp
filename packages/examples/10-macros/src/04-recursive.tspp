import type { MacroContext, MacroReturn, MacroTarget } from "@tspp/plugin-macros/sdk";

interface RecursiveUser { id: number }

export macro function begin([target]: readonly MacroTarget[], context: MacroContext): MacroReturn {
  return context.factory.createMacroInvocationStatement(
    context.factory.createIdentifier("finish"),
    [context.factory.createIdentifier(target.name)],
  );
}

export macro function finish([target]: readonly MacroTarget[], context: MacroContext): MacroReturn {
  const { factory, NodeFlags } = context.typescript;
  const literal = factory.createStringLiteral(target.name);
  return factory.createVariableStatement(undefined, factory.createVariableDeclarationList([
    factory.createVariableDeclaration(`${target.name}Expanded`, undefined, factory.createLiteralTypeNode(literal), literal),
  ], NodeFlags.Const));
}

macro begin(RecursiveUser);
const checkedRecursiveName: "RecursiveUser" = RecursiveUserExpanded;
console.log(checkedRecursiveName);
