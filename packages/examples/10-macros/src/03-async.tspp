import type { MacroContext, MacroResult, MacroTarget } from "@tspp/plugin-macros/sdk";

export interface AsyncUser { id: number }

export async macro function exposeLater(
  [target]: readonly MacroTarget[],
  context: MacroContext,
) with { timeout: { type: "fixed", value: 2, unit: "s" }; }: Promise<MacroResult> {
  await new Promise<void>(resolve => setTimeout(resolve, 10));
  const { factory, NodeFlags } = context.typescript;
  const literal = factory.createStringLiteral(target.name);
  return factory.createVariableStatement(
    undefined,
    factory.createVariableDeclarationList([
      factory.createVariableDeclaration(`${target.name}AsyncName`, undefined, factory.createLiteralTypeNode(literal), literal),
    ], NodeFlags.Const),
  );
}

macro exposeLater(AsyncUser);
const checkedAsyncName: "AsyncUser" = AsyncUserAsyncName;
console.log(checkedAsyncName);
