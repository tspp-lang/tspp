export {};

export type Response<T> = let Payload = { data: T; status: "ok" } in {
    current: Payload;
    backup: Payload;
};

const response: Response<string> = {
    current: { data: "now", status: "ok" },
    backup: { data: "then", status: "ok" },
};

type Shadowed = let Value = number in let Value = string in Value;
const shadowed: Shadowed = "inner";
// @ts-expect-error A local type binding does not escape its body.
type EscapedBinding = Payload;

export type Classify<T> = match T {
    [infer Head, ...infer Tail]: { head: Head; tail: Tail },
    { data: infer Data; status: 200 }: Data,
    string: "text",
    _: "other"
};

const tuple: Classify<[string, number]> = { head: "first", tail: [1] };
const object: Classify<{ data: boolean; status: 200 }> = true;
const text: Classify<"hello"> = "text";
const other: Classify<symbol> = "other";

type Combined<T> = let Input = { data: T; status: 200 } in match Input {
    { data: infer Data }: Data,
    _: never
};
const combined: Combined<bigint> = 1n;

export type Identity = <T> =>> T;
export type Swap = <Left, Right> =>> [Right, Left];
export type CurriedPair = <Left> =>> <Right> =>> [Left, Right];
export type StringPair = CurriedPair<string>;
export type WithLeft<Left> = <Right> =>> [Left, Right];
export type NumberPair = WithLeft<number>;
export type OnlyString = <T extends string> =>> { tag: T };

const identity: Identity<number> = 42;
const swapped: Swap<string, number> = [1, "one"];
const pair: StringPair<boolean> = ["left", true];
const genericPair: NumberPair<boolean> = [1, true];
const constrained: OnlyString<"user"> = { tag: "user" };

// @ts-expect-error Swap requires two arguments.
type MissingArgument = Swap<string>;
// @ts-expect-error The constructor parameter is constrained to string.
type InvalidConstraint = OnlyString<number>;
