export {};

export type Identity = <T> =>> T;
export type First = <Left, Right> =>> Left;
export type Swap = <Left, Right> =>> [Right, Left];
export type CurriedPair = <Left> =>> <Right> =>> [Left, Right];
export type StringPair = CurriedPair<string>;
export type WithLeft<Left> = <Right> =>> [Left, Right];
export type NumberPair = WithLeft<number>;
export type OnlyString = <T extends string> =>> { tag: T };

type Apply<Constructor: Type => Type, Value> = Constructor<Value>;
type Compose<Outer: Type => Type, Inner: Type => Type> =
    <Value> =>> Outer<Inner<Value>>;
type Box = <Value> =>> { readonly value: Value };
type Twice = Compose<Array, Array>;

const identity: Identity<number> = 42;
const first: First<boolean, string> = true;
const swapped: Swap<string, number> = [1, "one"];
const pair: StringPair<boolean> = ["left", true];
const genericPair: NumberPair<boolean> = [1, true];
const constrained: OnlyString<"user"> = { tag: "user" };
const boxed: Apply<Box, number> = { value: 42 };
const nested: Twice<string> = [["TS++"]];

// @ts-expect-error Swap requires two arguments.
type MissingArgument = Swap<string>;
// @ts-expect-error A value type is not a unary type constructor.
type InvalidConstructor = Apply<string, number>;
// @ts-expect-error The constructor parameter is constrained to string.
type InvalidConstraint = OnlyString<number>;

void identity;
void first;
void swapped;
void pair;
void genericPair;
void constrained;
void boxed;
void nested;
