// ============================================================================
// 03-advanced-classes / 02-sealed-and-final.tspp
//
// 封闭类层次（`sealed class`）、终态限制（`final`）与编译期安全边界
//
// 在设计类的继承体系时，完全开放的继承往往会带来两个问题：
//   1. 如果基类允许在任意外部文件中被随意继承，你就无法确定它到底有多少种子类分支；
//   2. 如果基类中的核心方法被子类意外重写，可能会破坏基类依赖的不变式。
//
// 为此，TS++ 引入了两个精确控制继承边界的修饰符：
//   - `sealed class`（封闭类）：只允许在**当前同一个源文件内**被继承，外部文件一律禁止扩展；
//     配合 `object` 单例与 `data class` 子类，可以用面向对象的方式构造封闭的代数类层次；
//   - `final`（终态修饰符）：修饰类（`final class`）时完全禁止被继承；修饰方法（`final method`）时禁止被子类重写。
// ============================================================================
// Sealed Class Hierarchies (`sealed class`), Finality (`final`) & Compile-Time Safety Boundaries
//
// When designing class hierarchies, unrestricted inheritance often causes two problems:
//   1. If a base class can be extended in any external file, you can never know the complete set of its subclasses;
//   2. If a core method on a base class is accidentally overridden by a subclass, class invariants can be broken.
//
// To give you precise control over inheritance boundaries, TS++ introduces two modifiers:
//   - `sealed class`: May only be extended within the **same declaring source file**; external files cannot subclass it.
//     Combined with `object` singletons and `data class` subclasses, it models closed algebraic class hierarchies;
//   - `final`: When applied to a class (`final class`), forbids all subclassing; when applied to a method (`final method`),
//     forbids subclasses from overriding that method.
// ============================================================================

export {};

// ----------------------------------------------------------------------------
// 1. `sealed class` 封闭类层次（结合 `object`、`data class` 与 `final` 方法）
//
// 写法：`sealed abstract class <基类名> { ... }`
// 效果：只能在当前文件内定义它的子类。无状态的分支可用 `object ... extends <基类>`，
// 携带数据的分支可用 `data class ... extends <基类>`，基类中的通用不变逻辑可标记为 `final`。
// ----------------------------------------------------------------------------
// 1. `sealed class` Hierarchies (Combining `object`, `data class` & `final` Methods)
//
// Syntax: `sealed abstract class <BaseName> { ... }`
// Effect: Subclasses can only be declared in this file. Stateless variants use `object ... extends <Base>`,
// payload-carrying variants use `data class ... extends <Base>`, and shared invariant methods use `final`.
// ----------------------------------------------------------------------------

// 定义一个封闭抽象基类 `Outcome`
// Define a sealed abstract base class `Outcome`
sealed abstract class Outcome {
  abstract summary(): string;

  // `final` 方法：所有子类共享该实现，且任何子类都不允许重写它
  // `final` method: shared across all subclasses and cannot be overridden by any subclass
  final isResolved(): boolean {
    return this !== Pending;
  }
}

// 分支 1：无状态单例分支 `Pending`
// Variant 1: Stateless singleton variant `Pending`
object Pending extends Outcome {
  summary(): string {
    return "pending";
  }
}

// 分支 2：携带数值结果的数据类分支 `Done`
// Variant 2: Payload-carrying data class variant `Done`
data class Done(value: number) extends Outcome {
  summary(): string {
    return `done:${this.value}`;
  }
}

// 分支 3：携带原因说明的数据类分支 `Failed`
// Variant 3: Payload-carrying data class variant `Failed`
data class Failed(reason: string) extends Outcome {
  summary(): string {
    return `failed:${this.reason}`;
  }
}

const outcomes: Outcome[] = [Pending, new Done(42), new Failed("timeout")];
const formattedOutcomes: string[] = outcomes.map(
  item => `${item.summary()}(resolved=${item.isResolved()})`,
);

// ----------------------------------------------------------------------------
// 2. `final class` 与 `final` 方法
//
// 写法：
//   - `final class <类名> { ... }`：彻底禁止任何类 `extends <类名>`；
//   - `final <方法名>(...) { ... }`：允许类本身被继承，但禁止子类重写该方法。
// ----------------------------------------------------------------------------
// 2. `final class` & `final` Methods
//
// Syntax:
//   - `final class <ClassName> { ... }`: Completely forbids any class from extending `<ClassName>`;
//   - `final <methodName>(...) { ... }`: Allows the class to be subclassed, but forbids overriding that method.
// ----------------------------------------------------------------------------

// 终态类 `LockedBox`：不允许派生任何子类
// Final class `LockedBox`: cannot be subclassed
final class LockedBox {
  constructor(public readonly value: number) {}
}

// 普通基类 `BaseComputation`：`tag()` 方法被声明为 `final`，`compute()` 允许子类重写
// Base class `BaseComputation`: `tag()` is marked `final`, while `compute()` can be overridden by subclasses
class BaseComputation {
  final tag(): string {
    return "base";
  }

  compute(input: number): number {
    return input;
  }
}

class DoubledComputation extends BaseComputation {
  override compute(input: number): number {
    return input * 2;
  }
}

const box = new LockedBox(10);
const computation = new DoubledComputation();

// ----------------------------------------------------------------------------
// 3. 编译期错误拦截（`@ts-expect-error`）
//
// 下面验证当代码违反 `final class`、`final` 方法、`field` 作用域或 `with` 属性检查时，
// 编译器如何在编译阶段直接报错拦截。
// ----------------------------------------------------------------------------
// 3. Compile-Time Error Interception (`@ts-expect-error`)
//
// The examples below verify that violating `final class`, `final` method, `field` scope, or `with` property
// rules is rejected directly at compile time.
// ----------------------------------------------------------------------------

export function compileTimeBoundaryChecks(): void {
  // 1. 禁止继承 `final class`
  // 1. Cannot inherit from a `final class`
  // @ts-expect-error [TS19101] Cannot inherit from final class 'LockedBox'.
  class IllegalBoxSubclass extends LockedBox {}

  // 2. 禁止在子类中重写基类的 `final` 方法
  // 2. Cannot override a `final` method in a subclass
  class IllegalMethodOverride extends BaseComputation {
    // @ts-expect-error [TS19103] Cannot override final member 'tag'.
    override tag(): string {
      return "overridden";
    }
  }

  // 3. `field` 隐式后备存储关键字只能出现在 `field` 属性的 `get` 或 `set` 内部
  // 3. The implicit backing identifier `field` is only allowed inside a `field` getter or setter
  function illegalFieldReference(): unknown {
    // @ts-expect-error [TS19104] 'field' is only allowed inside a getter or setter.
    return field;
  }

  // 4. `with` 表达式会严格检查属性名是否存在于目标实例类型上
  // 4. `with` expressions strictly check that patch properties exist on the target type
  const sampleDone = new Done(1);
  // @ts-expect-error Object literal may only specify known properties on Done.
  const invalidCopy = with(sampleDone, { unknownProperty: 123 });

  console.log(IllegalBoxSubclass, IllegalMethodOverride, illegalFieldReference, invalidCopy);
}

console.log("[02-sealed-and-final]", {
  formattedOutcomes,
  lockedValue: box.value,
  computationTag: computation.tag(),
  computedValue: computation.compute(21),
});
