export newtype UserId = string;
export newtype OrderId = string;
newtype Box<T> = T;
export data Option<T> = None | Some(value: T);
data List<T> = Nil | Cons(head: T, tail: List<T>);
export data Status = Idle | Loading | Ready;
export data OptionBox = OptionBox(value: Option<number>);

const userId: UserId = UserId("user-1");
const orderId: OrderId = OrderId("order-1");
const rawUserId: string = userId;
const boxed: Box<number> = Box(42);
const unboxed: number = boxed;
const nothing: Option<number> = None;
const something: Option<number> = Some(42);
const selected: number = match something {
  None => 0,
  Some(value) => value,
};
const fallback: number = match nothing {
  Some(value) => value,
  _ => 0,
};
const guardedOption: Option<string> = Some("TS++");
const guarded: string = match guardedOption {
  Some(value) if value.length > 3 => value,
  Some(_) => "short",
  None => "missing",
};
function currentStatus(): Status {
  return Loading;
}
const sharedStatus: string = match currentStatus() {
  Idle | Loading => "waiting",
  Ready => "ready",
};
const nestedOption = OptionBox(Some(9));
const nestedValue: number = match nestedOption {
  OptionBox(None()) => 0,
  OptionBox(Some(value)) => value,
};
let evaluationCount = 0;
function nextOption(): Option<number> {
  evaluationCount++;
  return Some(7);
}
const evaluatedOnce = match nextOption() {
  None => 0,
  Some(value) => value,
};
if (evaluationCount !== 1) throw new Error("match scrutinee was evaluated more than once");
const list: List<number> = Cons(1, Cons(2, Nil));
function length(values: List<number>): number {
  return match values {
    Nil => 0,
    Cons(head, tail) => head * 0 + 1 + length(tail),
  };
}
const listLength = length(list);
function compileTimeErrorExamples(): void {
  const unknownOption = null as unknown as Option<number>;
  // @ts-expect-error A non-exhaustive match omits None.
  const incomplete: number = match unknownOption {
    Some(value) => value,
  };
  // @ts-expect-error Some has only one positional field.
  const invalidPattern = match unknownOption {
    None => 0,
    Some(value, extra) => value,
  };
  // @ts-expect-error A guarded constructor does not exhaust that constructor.
  const guardedOnly = match unknownOption {
    Some(value) if Number(value) > 0 => value,
    None => 0,
  };
  // @ts-expect-error Or-patterns currently share only nullary constructors.
  const invalidOrPattern = match unknownOption {
    None | Some(_) => 0,
  };

  const wrongSome = Some("wrong");
  // @ts-expect-error Variant fields retain their declared types.
  const wrongValue: number = wrongSome.value;
  // @ts-expect-error A string variant is not an Option<number>.
  const badOption: Option<number> = wrongSome;
  // @ts-expect-error Data values are nominal, not structural lookalikes.
  const forgedOption: Option<number> = { _tag: "None", _values: [] };
}

console.log(
  userId,
  orderId,
  rawUserId,
  unboxed,
  nothing,
  something,
  selected,
  fallback,
  guarded,
  sharedStatus,
  nestedValue,
  evaluatedOnce,
  listLength,
);

// Deliberately invalid when uncommented:
// const wrong: UserId = orderId;
// const alsoWrong: UserId = "user-2";
