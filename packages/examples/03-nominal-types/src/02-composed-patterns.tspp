// ============================================================================
// 03-nominal-types / 02-composed-patterns.tspp
//
// 多参数代数类型、多层嵌套模式匹配与对象名义包装
//
// 在掌握了基础的 `newtype`、`data` 与 `match` 之后，本文件演示它们在组合场景下的用法：
//   - 带有多个泛型参数的代数数据类型（如 `Either<Left, Right>`）及通用转换函数；
//   - 将一个 `data` 类型嵌套在另一个 `data` 类型内部，并在 `match` 中一次性深层解构与守卫过滤；
//   - 用 `newtype` 包装对象结构时，底层对象的属性键查询（`keyof`）如何自然保留。
// ============================================================================
// Multi-Parameter ADTs, Deeply Nested Pattern Matching, and Object Newtypes
//
// Building on the basic `newtype`, `data`, and `match` constructs, this file demonstrates
// how they compose in richer scenarios:
//   - Algebraic data types with multiple type parameters (such as `Either<Left, Right>`) and generic mapping;
//   - Nesting one `data` type inside another and matching multiple constructor levels with `if` guards;
//   - Wrapping an object type with `newtype` while preserving property-key queries (`keyof`).
// ============================================================================

export {};

// ----------------------------------------------------------------------------
// 1. 多类型参数代数类型与泛型转换
//
// `data` 声明支持任意数量的泛型参数。利用 `match` 可以编写类型安全的容器映射函数。
// ----------------------------------------------------------------------------
// 1. Multi-Parameter ADTs & Generic Transformations
//
// `data` declarations accept any number of type parameters. Combined with `match`, you can write
// type-safe transformation functions over generic sum types.
// ----------------------------------------------------------------------------

// 包含左值 `Left`、右值 `Right` 与空状态 `Empty` 的二元和类型
// A sum type with `Left(value)`, `Right(value)`, and a nullary `Empty` variant
data Either<Left, Right> = Left(value: Left) | Right(value: Right) | Empty;

const left: Either<number, string> = Left(1);
const right: Either<number, string> = Right("TS++");
const empty: Either<number, string> = Empty;

// 仅对 `Right` 分支内部的值应用转换函数，`Left` 和 `Empty` 原样保持
// Apply `transform` only to the value inside `Right`, leaving `Left` and `Empty` untouched
function mapRight<LeftValue, RightValue, Output>(
  value: Either<LeftValue, RightValue>,
  transform: (right: RightValue) => Output,
): Either<LeftValue, Output> {
  return match value {
    Left(item) => Left(item),
    Right(item) => Right(transform(item)),
    Empty => Empty,
  };
}

const mapped: Either<number, number> = mapRight(right, value => value.length);

// ----------------------------------------------------------------------------
// 2. 多层嵌套构造器解构与守卫组合
//
// 当一个 `data` 的字段本身又是另一个 `data` 时，`match` 分支可以直接写出多层构造器模式
// （如 `Finished(Success(value))`），并在同一分支上附加 `if` 守卫条件。
// ----------------------------------------------------------------------------
// 2. Deeply Nested Constructor Patterns & Guards
//
// When a `data` variant carries another `data` value as its field, `match` arms can destructure
// multiple constructor layers at once (e.g., `Finished(Success(value))`) and attach `if` guards.
// ----------------------------------------------------------------------------

// 内层结果类型：成功携带数值 `Success(value)`，失败携带错误码 `Failure(code)`
// Inner result type: `Success(value)` or `Failure(code)`
data Outcome = Success(value: number) | Failure(code: number);

// 外层阶段类型：未完成时为 `Idle` 或 `Loading`，完成时包裹一个内层 `Outcome`
// Outer state type: `Idle`, `Loading`, or `Finished(outcome)` wrapping an inner `Outcome`
data Stage = Idle | Loading | Finished(outcome: Outcome);

// 一次性匹配外层 `Stage` 与内层 `Outcome`，并结合 `if` 守卫区分正数结果与非正数结果
// Match both outer `Stage` and inner `Outcome` in one pattern, using an `if` guard to filter positive values
function evaluateStage(stage: Stage): number {
  return match stage {
    Idle | Loading => 0,
    Finished(Success(value)) if value > 0 => value,
    Finished(Success(_)) => 0,
    Finished(Failure(code)) => -code,
  };
}

const positiveScore: number = evaluateStage(Finished(Success(42)));
const negativeScore: number = evaluateStage(Finished(Failure(5)));

// ----------------------------------------------------------------------------
// 3. 对象结构的 `newtype` 包装与名义防伪
//
// 用 `newtype` 包装对象类型时，它既拥有独立的名义身份，又保留了底层对象的属性结构与 `keyof` 查询能力。
// 同时，任何试图用普通字面量对象伪造 `data` 分支的行为都会被编译器拒绝。
// ----------------------------------------------------------------------------
// 3. Object `newtype` Wrappers & Nominal Brand Enforcement
//
// Wrapping an object type with `newtype` gives it a distinct nominal identity while preserving
// underlying property access and `keyof` queries. Plain object literals still cannot forge `data` variants.
// ----------------------------------------------------------------------------

newtype Point = { x: number; y: number };

// `keyof Point` 依然能够准确提取出底层对象的属性名联合 `"x" | "y"`
// `keyof Point` accurately preserves the underlying object's property keys `"x" | "y"`
const pointKeys: "x" | "y" = "x" satisfies keyof Point;

function compileTimeErrorExamples(): void {
  // 手写结构相似的对象不能伪装成无参构造器 `Empty` 的类型
  // A structurally similar object literal cannot masquerade as the type of variant `Empty`
  // @ts-expect-error Structurally similar values do not carry the variant brand.
  const forged: typeof Empty = { _tag: "Empty" as const };
  console.log(forged);
}

console.log("[02-composed-patterns]", {
  left,
  right,
  empty,
  mapped,
  positiveScore,
  negativeScore,
  pointKeys,
  compileTimeErrorExamples,
});
