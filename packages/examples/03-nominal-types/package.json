    }
  },
  "scripts": {
    "build": "tspp -p tsconfig.json --pretty false",
    "check": "tspp -p tsconfig.json --noEmit --pretty false",
    "lint": "eslint src"
  },
  "dependencies": {
    "@tspp/plugin-nominal-types": "workspace:*",
    "ts-plus-plus": "workspace:*"
  },
  "devDependencies": {
    "eslint": "^10.10.0"
  }
}
