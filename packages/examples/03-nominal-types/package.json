{
  "name": "@tspp/example-nominal-types",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Example project for TS++ nominal newtypes and algebraic data types.",
  "tsppTypes": "./dist/01-basics.d.tspp",
  "types": "./dist/01-basics.d.ts",
  "exports": {
    ".": {
      "tspp-types": "./dist/01-basics.d.tspp",
      "types": "./dist/01-basics.d.ts",
