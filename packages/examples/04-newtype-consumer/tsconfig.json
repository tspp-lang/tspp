{
  "compilerOptions": {
    "strict": true,
    "rootDir": "src",
    "outDir": "dist",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "plugins": [
      {
        "name": "@tspp/plugin-newtype",
        "tspp": true
      }
    ]
  },
  "include": ["src/**/*.tspp"]
}
