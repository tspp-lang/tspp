import {
    Loading,
    None,
    OptionBox,
    Option,
    OrderId,
    Some,
    Status,
    UserId,
} from "@tspp/example-nominal-types";

type UserIdConstructor = typeof UserId;
const userId: UserId = UserId("consumer-1");
const orderId: OrderId = OrderId("order-1");
const importedOption: Option<number> = Some(3);
const importedValue: number = match importedOption {
    None => 0,
    Some(value) => value,
};
const importedStatus: Status = Loading;
const importedStatusText = match importedStatus {
    Loading => "loading",
    _ => "other",
};
const importedNested = match OptionBox(importedOption) {
    OptionBox(None()) => 0,
    OptionBox(Some(value)) if value > 0 => value,
    OptionBox(Some(_)) => 0,
};

// @ts-expect-error Distinct newtype declarations remain nominal across packages.
const wrong: UserId = orderId;

if (false) {
    // @ts-expect-error Erased constructors cannot escape into runtime values.
    const escapedConstructor: UserIdConstructor = UserId;
    // @ts-expect-error Newtype constructors require exactly one argument.
    UserId();
    // @ts-expect-error Extra arguments are rejected and are not silently erased.
    UserId("consumer-2", "extra");
    console.log(escapedConstructor);
}

console.log(userId, orderId, importedValue, importedStatusText, importedNested, wrong);
