{
  "compilerOptions": {
    "noEmit": true,
    "plugins": [
      {
        "name": "ts-plus-plus/plugins/formal-verification",
        "tspp": true
      },
      {
        "name": "ts-plus-plus/plugins/modern-syntax",
        "tspp": true
      },
      {
        "name": "ts-plus-plus/plugins/nominal-types",
        "tspp": true
      }
    ],
    "strict": true,
    "target": "ES2022"
  },
  "include": ["src/**/*.tspp"]
}
