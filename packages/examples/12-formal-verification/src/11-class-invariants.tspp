// ============================================================================
// 12-formal-verification / 11-class-invariants.tspp
//
// 类不变式（Class Invariants）：构造函数建立与方法保持
//
// 在面向对象编程中，一个类的对象往往需要始终维持某种内部状态合法性（例如“计数值 `health` 永远不能小于 0”或“余额 `balance` 永远非负”）。
// 这种在对象整个生命周期中都必须成立的性质，称为**类不变式（Class Invariant）**。
//
// 当在 `class` 声明上附加 `with { invariant: <条件>; }` 时，编译器会自动执行一套完整的归纳证明：
//   1. **构造建立（Constructor Establishment）**：证明构造函数执行完毕时，对象的所有字段满足 `invariant:`；
//   2. **方法保持（Method Preservation）**：假设方法被调用前 `invariant:` 成立（且参数满足方法的 `requires:`），
//      证明方法正常返回或中途抛出异常（`throw`）退出时，`invariant:` 依然保持成立；
//   3. **自动提供事实**：在任何实例方法（如 `getHealth()`）内部，编译器都可以直接将 `invariant:` 当作已知为真的前提来推导返回值性质。
// ============================================================================
// Class Invariants: Constructor Establishment & Method Preservation
//
// In object-oriented programming, instances of a class often need to maintain internal state validity throughout their lifetime
// (for example, `health >= 0` or `balance >= 0n`). Such a property is called a **class invariant**.
//
// When you attach `with { invariant: <condition>; }` to a `class`, the compiler automatically performs an inductive proof:
//   1. **Constructor Establishment**: Proves that `invariant:` holds at the end of the constructor (or field initializers);
//   2. **Method Preservation**: Assuming `invariant:` holds on method entry (along with any method `requires:`),
//      proves that `invariant:` still holds on every normal exit and every exceptional (`throw`) exit;
//   3. **Automatic Premise**: Inside any method (such as `getHealth()`), the compiler assumes `invariant:` holds on entry.
// ============================================================================

// ----------------------------------------------------------------------------
// 1. 构造建立、方法保持与读取方法推导
//
// 写法：`class <类名> with { invariant: <字段条件>; } { ... }`
// 效果：在下面的 `Player` 类中：
//   - 构造函数通过 `requires: initialHealth >= 0` 保证初始 `this.health >= 0`；
//   - `takeDamage` 使用 `Math.max(0, ...)` 确保扣减后 `this.health` 依然 `>= 0`
//     （若直接写无保护的 `this.health -= damage`，编译器会因 `health` 可能变为负数破坏类不变式而直接报错）；
//   - `heal` 在原本 `this.health >= 0` 的基础上加上正数 `amount > 0`，依然 `>= 0`；
//   - `getHealth` 直接利用类不变式证明返回值 `result >= 0`。
// ----------------------------------------------------------------------------
// 1. Constructor Establishment, Method Preservation & Reader Deduction
//
// Syntax: `class <ClassName> with { invariant: <field-condition>; } { ... }`
// Effect: In `Player` below:
//   - The constructor establishes `this.health >= 0` via `requires: initialHealth >= 0`;
//   - `takeDamage` uses `Math.max(0, ...)` so `this.health` remains `>= 0`
//     (writing an unguarded `this.health -= damage` would fail compilation because `health` could drop below `0`);
//   - `heal` adds `amount > 0` to `this.health >= 0`, preserving `this.health >= 0`;
//   - `getHealth` relies on the class invariant to prove `ensures: result >= 0`.
// ----------------------------------------------------------------------------

// 声明带类不变式 health >= 0 的类
// Declare a class with invariant `health >= 0`
class Player with {
    invariant: health >= 0;
    numberModel: "mathematical-real";
} {
    private health: number;

    // 构造函数：要求初始值非负，建立类不变式 health >= 0
    // Constructor: requires `initialHealth >= 0`, establishing invariant `health >= 0`
    public constructor(initialHealth: number) with { requires: initialHealth >= 0; } {
        this.health = initialHealth;
    }

    // 扣减方法：使用 Math.max(0, ...) 保证扣减后 health 不会跌破 0，保持类不变式
    // Reduction method: clamps with `Math.max(0, ...)` so `health` never drops below `0`, preserving the invariant
    public takeDamage(damage: number) with { requires: damage >= 0; }: void {
        this.health = Math.max(0, this.health - damage);
    }

    // 增加方法：在 health >= 0 基础上加上正数 amount，保持类不变式
    // Increment method: adds `amount > 0` to `health >= 0`, preserving the invariant
    public heal(amount: number) with { requires: amount > 0; }: void {
        this.health += amount;
    }

    // 读取方法：直接由类不变式 health >= 0 证明返回值 result >= 0
    // Reader method: directly proves `result >= 0` from the class invariant `health >= 0`
    public getHealth() with { ensures: result >= 0; }: number {
        return this.health;
    }
}

// ----------------------------------------------------------------------------
// 2. 字段默认初始化与异常退出路径（`throw`）下的不变式保持
//
// 当一个方法没有写前置条件（如 `withdraw`），而是用 `if (amount > this.balance) throw ...` 进行守卫时：
//   - 如果走 `throw` 异常路径：此时尚未修改 `this.balance`，因此抛出异常时类不变式 `balance >= 0n` 依然完好；
//   - 如果走正常路径：说明 `amount <= this.balance`，因此执行 `this.balance -= amount` 后依然满足 `balance >= 0n`。
// ----------------------------------------------------------------------------
// 2. Field Initializers & Invariant Preservation Across `throw` Exits
//
// When a method guards state updates with `if (amount > this.balance) throw ...` instead of a precondition:
//   - On the `throw` path: `this.balance` has not been mutated yet, so `balance >= 0n` remains intact;
//   - On the normal path: `!(amount > this.balance)` implies `amount <= this.balance`, so `this.balance -= amount` stays `>= 0n`.
// ----------------------------------------------------------------------------

// 通过字段默认值 0n 建立初始不变式 balance >= 0n
// Establish the initial invariant `balance >= 0n` via field initializer `0n`
class Account with { invariant: balance >= 0n; } {
    private balance = 0n;

    // 存入非负金额，保持 balance >= 0n
    // Deposit a non-negative amount, preserving `balance >= 0n`
    deposit(amount: bigint) with { requires: amount >= 0n; }: void {
        this.balance += amount;
    }

    // 在修改状态前先通过异常守卫拦截超额扣减，异常出口与正常出口均保持 balance >= 0n
    // Guard against over-withdrawal with `throw` before mutating state; both normal and throw exits preserve `balance >= 0n`
    withdraw(amount: bigint): void {
        if (amount > this.balance) throw new Error("insufficient funds");
        this.balance -= amount;
    }
}

const hero = new Player(100);
hero.takeDamage(30);
hero.heal(10);

const account = new Account();
account.deposit(50n);
account.withdraw(20n);

console.log(hero.getHealth());
