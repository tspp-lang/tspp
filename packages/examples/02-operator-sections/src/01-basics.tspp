// ============================================================================
// 02-operator-sections / 01-basics.tspp
//
// 运算符与属性切片（`_` 占位符简写函数）
//
// 在日常处理集合或高阶函数时，我们经常需要编写只做一步简单运算的短小箭头函数，例如：
//   - 把每个数加 1：`x => x + 1`
//   - 把两个数相加：`(left, right) => left + right`
//   - 读取对象属性：`item => item.name`
//   - 调用对象方法：`text => text.trim()`
// 在这些极简场景下，反复书写 `x => x...` 的参数声明显得冗长重复。
//
// 为此，TS++ 引入了基于 `_` 占位符的“切片表达式（Operator & Member Sections）”：
// 在括号内（或直接作为高阶函数的参数），用 `_` 代表函数的待传入参数，即可直接写出对应的简写函数：
//   - 包含 1 个 `_` 的表达式会生成单参数函数；
//   - 包含 2 个 `_` 的二元运算（如 `(_ / _)`）会按从左到右的顺序生成双参数函数。
// ============================================================================
// Operator & Member Sections (`_` Placeholder Functions)
//
// When working with collections and higher-order functions, you frequently write tiny arrow functions
// that perform a single operation on their arguments:
//   - Add 1 to a number: `x => x + 1`
//   - Add two numbers: `(left, right) => left + right`
//   - Read a property: `item => item.name`
//   - Call a method: `text => text.trim()`
// Repeating `x => x...` for every short expression adds unnecessary visual noise.
//
// To streamline this, TS++ introduces operator and member sections using the `_` placeholder:
// Inside parentheses (or directly as a call argument), `_` stands in for a function parameter:
//   - An expression with one `_` forms a unary function;
//   - A binary operator with two `_` placeholders (like `(_ / _)`) forms a binary function from left to right.
// ============================================================================

export {};

// ----------------------------------------------------------------------------
// 1. 单参数与双参数算术/比较切片
//
// 写法：`(_ + 1)`、`(10 - _)`、`(_ + _)`、`(_ > 0)`、`(_ * 2 + 1)`
// 效果：
//   - 右切片 `(_ + 1)`：接收参数 `x`，返回 `x + 1`；
//   - 左切片 `(10 - _)`：严格保持运算顺序，接收参数 `x`，返回 `10 - x`；
//   - 双占位符切片 `(_ / _)`：接收两个参数 `(left, right)`，返回 `left / right`；
//   - 组合算术切片 `(_ * 2 + 1)`：遵循标准运算符优先级，先乘 2 再加 1。
// ----------------------------------------------------------------------------
// 1. Unary & Binary Arithmetic and Comparison Sections
//
// Syntax: `(_ + 1)`, `(10 - _)`, `(_ + _)`, `(_ > 0)`, `(_ * 2 + 1)`
// Effect:
//   - Right section `(_ + 1)`: takes `x` and returns `x + 1`;
//   - Left section `(10 - _)`: preserves operand order, taking `x` and returning `10 - x`;
//   - Binary section `(_ / _)`: takes `(left, right)` in left-to-right order and returns `left / right`;
//   - Combined arithmetic `(_ * 2 + 1)`: follows standard operator precedence (`x * 2 + 1`).
// ----------------------------------------------------------------------------

// 右切片：等价于 `value => value + 1`
// Right section: equivalent to `value => value + 1`
const addOne: (value: number) => number = (_ + 1);

// 左切片：等价于 `value => 10 - value`（注意被减数固定为 10，减数为传入参数）
// Left section: equivalent to `value => 10 - value` (10 is the minuend, parameter is the subtrahend)
const subtractFromTen: (value: number) => number = (10 - _);

// 双占位符切片：两个 `_` 依次对应第一个参数 `left` 和第二个参数 `right`
// Binary sections: the two `_` placeholders bind to `left` and `right` in order
const add: (left: number, right: number) => number = (_ + _);
const divide: (left: number, right: number) => number = (_ / _);

// 比较运算切片：等价于 `value => value > 0`
// Comparison section: equivalent to `value => value > 0`
const isPositive: (value: number) => boolean = (_ > 0);

// 复合算术切片：等价于 `value => value * 2 + 1`
// Compound arithmetic section: equivalent to `value => value * 2 + 1`
const affine: (value: number) => number = (_ * 2 + 1);

// ----------------------------------------------------------------------------
// 2. 属性访问与方法调用切片
//
// 写法：`(_.name)`、`(_.inner.name)`、`(_.trim())`
// 效果：将对 `_` 的单层属性读取、链式属性读取或方法调用直接转化为接收该对象的单参数函数。
// ----------------------------------------------------------------------------
// 2. Property Access & Method Call Sections
//
// Syntax: `(_.name)`, `(_.inner.name)`, `(_.trim())`
// Effect: Turns single-level property reads, chained property reads, or method calls on `_`
// into unary functions taking the target object.
// ----------------------------------------------------------------------------

// 读取单层属性：等价于 `value => value.name`
// Single property access: equivalent to `value => value.name`
const readName: (value: { name: string }) => string = (_.name);

// 链式读取嵌套属性：等价于 `value => value.inner.name`
// Chained nested property access: equivalent to `value => value.inner.name`
const readNestedName: (value: { inner: { name: string } }) => string = (_.inner.name);

// 调用对象方法：等价于 `value => value.trim()`
// Method call section: equivalent to `value => value.trim()`
const trim: (value: string) => string = (_.trim());

// ----------------------------------------------------------------------------
// 3. 在高阶函数中直接内联使用与上下文类型推导
//
// 当把 `_` 切片直接写在 `.map(...)`、`.filter(...)` 等函数调用的参数位置时，
// 不仅无需额外套一层括号，而且 `_` 的类型会自动从数组元素类型推导出来。
// ----------------------------------------------------------------------------
// 3. Inline Usage in Higher-Order Calls & Contextual Type Inference
//
// When passed directly as an argument to `.map(...)` or `.filter(...)`, a section needs no
// extra parentheses, and the type of `_` is inferred automatically from the array element type.
// ----------------------------------------------------------------------------

const numbers: number[] = [1, 2, 3];

// 直接将每个元素乘以 2：`[2, 4, 6]`
// Multiply each element by 2 directly: `[2, 4, 6]`
const doubled: number[] = numbers.map(_ * 2);

// 先过滤出大于 1 的元素 `[2, 3]`，再计算 `_ * 10 + 1` 得到 `[21, 31]`
// Filter elements greater than 1 (`[2, 3]`), then map `_ * 10 + 1` to get `[21, 31]`
const transformed: number[] = numbers.filter(_ > 1).map(_ * 10 + 1);

// ----------------------------------------------------------------------------
// 4. 编译期错误拦截（`@ts-expect-error`）
//
// `_` 切片生成的函数同样受严格的类型检查约束：操作数类型不兼容或访问不存在的属性都会在编译期报错。
// ----------------------------------------------------------------------------
// 4. Compile-Time Error Interception (`@ts-expect-error`)
//
// Functions created by `_` sections are strictly type-checked: incompatible operand types or
// non-existent properties are rejected at compile time.
// ----------------------------------------------------------------------------

export function compileTimeErrorExamples(): void {
  // 1. 在 `number[]` 上使用 `_ > 0` 返回的是 `boolean`，不能当作返回 `string` 的映射函数
  // 1. `_ > 0` on `number[]` yields `boolean[]`, which cannot be assigned to `string[]`
  // @ts-expect-error Comparison section returns boolean, not string.
  const wrongMapResult: string[] = numbers.map(_ > 0);

  // 2. 属性切片会严格检查参数对象是否包含该属性
  // 2. Property sections verify that the target object actually declares the accessed property
  const readCount: (value: { count: number }) => number = (_.count);
  // @ts-expect-error Object is missing required property count.
  readCount({ label: "wrong" });

  console.log(wrongMapResult);
}

console.log("[01-basics]", {
  addOne: addOne(41),
  subtractFromTen: subtractFromTen(3),
  add: add(20, 22),
  divide: divide(84, 2),
  readName: readName({ name: "TS++" }),
  readNestedName: readNestedName({ inner: { name: "section" } }),
  trim: trim("  TS++  "),
  isPositive: isPositive(42),
  affine: affine(20),
  doubled,
  transformed,
  compileTimeErrorExamples,
});
