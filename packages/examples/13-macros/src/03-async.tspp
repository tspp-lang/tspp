// ============================================================================
// 13-macros / 03-async.tspp
//
// 异步编译期宏（`async macro`）
//
// 如果编译期代码生成需要等待异步操作完成，可以将宏声明为 `async macro`。
// 编译器会自动等待宏返回的 `Promise<MacroResult>` 解析完成后，再将生成的语句接入类型检查与编译流程。
// ============================================================================
// Asynchronous Compile-Time Macros (`async macro`)
//
// When compile-time code generation needs to await an asynchronous step, a macro can be declared as `async macro`.
// The compiler awaits the returned `Promise<MacroResult>` before splicing the generated statements into type checking and emit.
// ============================================================================

import type { MacroContext, MacroResult, MacroTarget } from "ts-plus-plus/plugins/macros/sdk";

// ----------------------------------------------------------------------------
// 1. 定义带超时配置的异步宏
//
// 写法：`export async macro({ timeout: ... }) function <宏名>(...): Promise<MacroResult>`
// 效果：允许在宏函数体内使用 `await`，并在预算时间内异步返回生成的语法树节点。
// ----------------------------------------------------------------------------
// 1. Defining an Asynchronous Macro with a Timeout Budget
//
// Syntax: `export async macro({ timeout: ... }) function <name>(...): Promise<MacroResult>`
// Effect: Allows `await` inside the macro body and resolves the generated AST statement within the configured timeout.
// ----------------------------------------------------------------------------

// 作为宏输入目标的接口 `Item`
// Target interface `Item` passed to the asynchronous macro
export interface Item {
  readonly id: number;
}

// 声明一个最大执行预算为 2 秒的异步编译期宏，等待异步步骤后生成常量声明 `<目标名>AsyncName`
// Declare an async compile-time macro with a 2-second timeout budget that generates `<TargetName>AsyncName` after awaiting
export async macro({ timeout: { type: "fixed", value: 2, unit: "s" } }) function exposeLater(
  [target]: readonly MacroTarget[],
  context: MacroContext,
): Promise<MacroResult> {
  await new Promise<void>(resolve => setTimeout(resolve, 10));

  const { factory, NodeFlags } = context.typescript;
  const literal = factory.createStringLiteral(target.name);
  return factory.createVariableStatement(
    undefined,
    factory.createVariableDeclarationList([
      factory.createVariableDeclaration(
        `${target.name}AsyncName`,
        undefined,
        factory.createLiteralTypeNode(literal),
        literal,
      ),
    ], NodeFlags.Const),
  );
}

// ----------------------------------------------------------------------------
// 2. 调用异步宏并读取展开结果
//
// 调用侧语法与同步宏完全一致（无需在调用处写 `await`），编译器会在编译阶段自动等待展开完成。
// ----------------------------------------------------------------------------
// 2. Invoking the Async Macro & Using the Expanded Binding
//
// The call-site syntax is identical to a synchronous macro (no `await` at the call site); the compiler awaits
// the expansion automatically during compilation.
// ----------------------------------------------------------------------------

// 调用异步宏，在编译期生成 `const ItemAsyncName: "Item" = "Item"`
// Invoke the async macro to generate `const ItemAsyncName: "Item" = "Item"` at compile time
macro exposeLater(Item);

// 验证异步宏生成的常量与字面量类型
// Verify the constant and literal type generated by the async macro
const checkedAsyncName: "Item" = ItemAsyncName;
console.log("[03-async]", { checkedAsyncName });
