{
  "compilerOptions": {
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "plugins": [
      {
        "name": "ts-plus-plus/plugins/nominal-types",
        "tspp": true
      }
    ]
  },
  "include": ["src/**/*.ts", "src/**/*.tspp"]
}
