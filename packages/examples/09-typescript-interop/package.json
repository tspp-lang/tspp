{
  "name": "@tspp/example-typescript-interop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dual declaration and one-way source interop example for TS++ and TypeScript.",
  "main": "./dist/01-library.js",
  "types": "./dist/01-library.d.ts",
  "tsppTypes": "./dist/01-library.d.tspp",
  "exports": {
    ".": {
      "tspp-types": "./dist/01-library.d.tspp",
      "types": "./dist/01-library.d.ts",
      "default": "./dist/01-library.js"
    }
  },
  "scripts": {
    "build": "tspp -p tsconfig.json --pretty false",
    "check": "pnpm build && node ../../../node_modules/typescript/bin/tsc -p consumer/tsconfig.json --pretty false",
    "lint": "eslint src consumer/src"
  },
  "dependencies": {
    "@tspp/plugin-nominal-types": "workspace:*",
    "ts-plus-plus": "workspace:*"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.56.1"
  }
}
