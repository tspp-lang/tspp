// ============================================================================
// 09-higher-kinded-types / 03-kind-boundaries.tspp
//
// Kind 签名与类型宇宙层级的编译期安全检查（`@ts-expect-error`）
//
// 正如值级类型系统会阻止你把一个 `string` 传给要求 `(x: number) => number` 的函数，
// TS++ 的 Kind 检查器也会在编译期严格校验每一个类型与类型构造器的 Kind 签名和宇宙层级：
//   1. 参数个数（Arity）必须匹配：二元构造器 `(Type, Type) => Type` 不能传给要求一元构造器 `Type => Type` 的位置；
//   2. 构造器与普通值类型不可混用：`Type0` 值类型（如 `string`）不能当作 `Type => Type` 构造器调用；
//   3. 类型宇宙层级严格不累积（Non-Cumulative）：`Type0` 的类型不会自动变成 `Type1`；
//   4. 类型宇宙不可自包含：`Type0` 本身属于 `Type1`，不能归入 `Type0`；
//   5. 泛型别名省略参数时必须有显式高阶 Kind 标注，防止无意间漏写泛型参数。
// ============================================================================
// Compile-Time Kind & Universe Safety Checks (`@ts-expect-error`)
//
// Just as the value-level type checker rejects passing a `string` where a function `(x: number) => number` is expected,
// TS++'s kind checker strictly validates kind signatures and universe levels at compile time:
//   1. Constructor arity must match: a binary `(Type, Type) => Type` constructor cannot satisfy `Type => Type`;
//   2. Value types are not constructors: a `Type0` type like `string` cannot be passed where `Type => Type` is required;
//   3. Universes are non-cumulative: a `Type0` value type does not inhabit `Type1`;
//   4. Universes cannot contain themselves: `Type0` lives in `Type1`, not `Type0`;
//   5. Referencing an unapplied generic alias requires an explicit higher-kinded annotation so omitted arguments are caught.
// ============================================================================

export {};

type Pair<Left, Right> = [Left, Right];
type Apply<Constructor: Type => Type, Value> = Constructor<Value>;
type LocalArray<Value> = Value[];

// ----------------------------------------------------------------------------
// 1. 构造器参数个数与阶数不匹配报错
// ----------------------------------------------------------------------------
// 1. Constructor Arity & Order Mismatch Errors
// ----------------------------------------------------------------------------

// 1. 参数个数不匹配：`Pair` 是二元构造器 `(Type, Type) => Type`，不能传给要求一元构造器 `Type => Type` 的 `Apply`
// 1. Arity mismatch: `Pair` has kind `(Type, Type) => Type`, which does not match `Apply`'s `Type => Type` parameter
// @ts-expect-error Pair has kind (Type, Type) => Type, not Type => Type.
type WrongArity = Apply<Pair, string>;

// 2. 阶数不匹配：`string` 是 0 阶值类型（`Type0`），不是一元类型构造器（`Type => Type`）
// 2. Order mismatch: `string` is a value type (`Type0`), not a unary type constructor (`Type => Type`)
// @ts-expect-error string is a value type, not a type constructor.
type NotAConstructor = Apply<string, number>;

// ----------------------------------------------------------------------------
// 2. 类型宇宙层级与未显式标注构造器报错
// ----------------------------------------------------------------------------
// 2. Universe Hierarchy & Unannotated Constructor Errors
// ----------------------------------------------------------------------------

// 3. 宇宙层级不累积：普通值类型 `number` 的 Kind 是 `Type0`，不能赋给声明为 `: Type1` 的类型别名
// 3. Non-cumulative universes: `number` has kind `Type0` and cannot be assigned to an alias annotated with `: Type1`
// @ts-expect-error Kinds are non-cumulative: an ordinary type has kind Type0, not Type1.
export type WrongUniverseLevel: Type1 = number;
declare const wrongUniverseLevel: WrongUniverseLevel;

// 4. 宇宙不可自包含：`Type0` 本身属于 `Type1`，不能将 `Type0` 标注为属于它自己（`: Type0`）
// 4. No self-containment: `Type0` lives in `Type1` and cannot be annotated as inhabiting `Type0` itself
// @ts-expect-error Type0 itself lives in Type1.
type UniverseCannotContainItself: Type0 = Type0;
declare const universeCannotContainItself: UniverseCannotContainItself;

// 5. 未标注高阶 Kind 时禁止裸用泛型别名：若不写 `: Type => Type`，直接写 `= LocalArray` 会被判定为漏传泛型参数
// 5. Unannotated bare generic alias: without `: Type => Type`, bare `LocalArray` is rejected as missing its type argument
// @ts-expect-error A non-generic alias needs an explicit kind to retain a constructor.
type MissingConstructorKind = LocalArray;
declare const missingConstructorKind: MissingConstructorKind;

void wrongUniverseLevel;
void universeCannotContainItself;
void missingConstructorKind;

