// ============================================================================
// 09-higher-kinded-types / 01-basics.tspp
//
// 类型的类型（Kind）与高阶类型基础（Higher-Kinded Types & `Functor`）
//
// 在标准 TypeScript 中，你可能尝试过写这样的代码，却发现语法根本不允许：
//
//   // 错误：TypeScript 不允许把未传参的泛型 `Container` 当作类型构造器来使用！
//   interface Functor<Container> {
//     map<A, B>(items: Container<A>, fn: (a: A) => B): Container<B>;
//   }
//
// 为什么在普通 TypeScript 里写不出上面的 `Functor`？
// 因为普通 TypeScript 只能把“已经填满参数的完整类型（如 `Array<number>`）”作为泛型参数传递，
// 却不能把“还没填参数的类型构造器本身（如不带尖括号的 `Array`）”作为参数传递！
//
// 为了解决这个问题，我们需要认识一个核心概念——**Kind（类型的分类 / 类型的签名）**：
//   - 就像“值”由“类型”来分类（例如 `42` 的类型是 `number`），**“类型”和“类型构造器”则由 Kind 来分类**：
//   - `Type0`（可简写为 `Type`）：代表普通的值类型（如 `number`、`string`、`Array<number>`），可以直接用来标注变量；
//   - `Type => Type`：代表**一元类型构造器**（如未传参的 `Array`），它接收 1 个类型参数，产出 1 个新类型；
//   - `(Type, Type) => Type`：代表**二元类型构造器**（如 `Pair`），它接收 2 个类型参数，产出 1 个新类型。
//
// 当一个泛型类型或泛型接口接收“另一个类型构造器（如 `Container: Type => Type`）”作为参数时，
// 它就被称为**高阶类型（Higher-Kinded Type，简称 HKT）**！
// ============================================================================
// Kinds & Higher-Kinded Types (`Type => Type`, `(Type, Type) => Type` & `Functor`)
//
// In standard TypeScript, you may have tried to write an abstraction over generic containers like this,
// only to find that the language forbids it:
//
//   // Error in standard TS: type parameter `Container` is not generic!
//   interface Functor<Container> {
//     map<A, B>(items: Container<A>, fn: (a: A) => B): Container<B>;
//   }
//
// Why does standard TypeScript reject this?
// Because standard TypeScript only lets you pass fully applied types (like `Array<number>`) as type arguments,
// and cannot pass an unapplied type constructor itself (like bare `Array`)!
//
// To solve this, TS++ introduces **Kinds (the types of types and type constructors)**:
//   - Just as values are classified by types (`42 : number`), **types and type constructors are classified by Kinds**:
//   - `Type0` (or `Type` for short): the kind of ordinary value types (`number`, `string`, `Array<number>`);
//   - `Type => Type`: the kind of **unary type constructors** (like bare `Array`), taking 1 type and producing 1 type;
//   - `(Type, Type) => Type`: the kind of **binary type constructors** (like `Pair`), taking 2 types and producing 1 type.
//
// A generic type or interface that accepts a type constructor parameter (such as `Container: Type => Type`)
// is called a **Higher-Kinded Type (HKT)**!
// ============================================================================

export {};

// ----------------------------------------------------------------------------
// 1. 0 阶值类型与类型宇宙层级（`Type0`、`Type1`、`Type2`）
//
// 普通的值类型（如 `number`）属于第 0 层类型宇宙 `Type0`。
// 而 `Type0` 本身作为一个分类，属于更高一层的 `Type1`；`Type1` 则属于 `Type2`。
// 我们同样可以编写在 `Type1` 层级上运作的高阶泛型别名（如 `IdentityAtOne<Kind: Type1>`）。
// ----------------------------------------------------------------------------
// 1. Proper Value Types & Universe Levels (`Type0`, `Type1`, `Type2`)
//
// Ordinary value types (like `number`) have kind `Type0`.
// `Type0` itself has kind `Type1`, and `Type1` has kind `Type2`.
// Type aliases can also parameterize over higher universes (such as `IdentityAtOne<Kind: Type1>`).
// ----------------------------------------------------------------------------

// 普通值类型 `number` 的 Kind 是 `Type0`
// Ordinary value type `number` has kind `Type0`
export type NumberAtType0: Type0 = number;

// `Type0` 属于 `Type1`，`Type1` 属于 `Type2`
// `Type0` lives in `Type1`, and `Type1` lives in `Type2`
export type UniverseZero: Type1 = Type0;
export type UniverseOne: Type2 = Type1;

// 在 `Type1` 层级上的恒等类型函数：接收一个属于 `Type1` 的参数（如 `Type0`）并原样返回
// An identity alias at level `Type1`: takes a `Kind: Type1` (such as `Type0`) and returns it unchanged
type IdentityAtOne<Kind: Type1>: Type1 = Kind;
export type PreservedType0: Type1 = IdentityAtOne<Type0>;

// ----------------------------------------------------------------------------
// 2. 一元与二元类型构造器（`Type => Type` 与 `(Type, Type) => Type`）
//
// 通过在类型参数或类型别名后标注 `: Type => Type` 或 `: (Type, Type) => Type`：
//   - 可以把内置的泛型 `Array` 赋值给类型别名 `Arrays: Type => Type`，然后再用 `Arrays<string>` 实例化；
//   - 可以把二元泛型 `Pair`（不带参数）直接传给高阶类型 `Apply2<Pair, string, number>`；
//   - 也可以把匿名类型函数 `Box = <Value> =>> { value: Value }` 传给 `Apply<Box, boolean>`。
// ----------------------------------------------------------------------------
// 2. Unary & Binary Type Constructors (`Type => Type` & `(Type, Type) => Type`)
//
// By annotating type parameters or aliases with `: Type => Type` or `: (Type, Type) => Type`:
//   - You can bind built-in `Array` to `Arrays: Type => Type` and later apply it as `Arrays<string>`;
//   - You can pass unapplied binary `Pair` into higher-kinded `Apply2<Pair, string, number>`;
//   - You can pass an anonymous type lambda `Box = <Value> =>> { value: Value }` into `Apply<Box, boolean>`.
// ----------------------------------------------------------------------------

// 将内置泛型 `Array` 保存为一元类型构造器别名 `Arrays`（签名为 `Type => Type`）
// Bind built-in `Array` to a unary constructor alias `Arrays` with kind `Type => Type`
export type Arrays: Type => Type = Array;

// 对构造器别名 `Arrays` 传入 `string`，得到 `string[]`
// Apply the constructor alias `Arrays` to `string`, producing `string[]`
export type StringArray = Arrays<string>;
const strings: StringArray = ["one", "two"];

// 定义二元泛型别名 `Pair`，以及接收二元构造器 `(Type, Type) => Type` 的高阶类型 `Apply2`
// Define binary alias `Pair` and higher-kinded `Apply2` taking `Constructor: (Type, Type) => Type`
type Pair<Left, Right> = [Left, Right];
type Apply2<Constructor: (Type, Type) => Type, Left, Right> = Constructor<Left, Right>;

// 将未传参的 `Pair` 作为参数传给 `Apply2`，计算出 `[string, number]`
// Pass unapplied `Pair` into `Apply2` to compute `[string, number]`
export type NamedPair = Apply2<Pair, string, number>;
const namedPair: NamedPair = ["answer", 42];

// 接收一元类型构造器 `Constructor: Type => Type` 的高阶应用类型 `Apply`
// Higher-kinded `Apply` taking a unary constructor `Constructor: Type => Type` and `Value`
type Apply<Constructor: Type => Type, Value> = Constructor<Value>;

// 匿名类型函数 `<Value> =>> { value: Value }` 同样拥有 `Type => Type` 签名，可直接传给 `Apply`
// Anonymous type lambda `Box` also has kind `Type => Type` and can be passed directly to `Apply`
type Box = <Value> =>> { value: Value };
export type BooleanBox = Apply<Box, boolean>;
const box: BooleanBox = { value: true };

// ----------------------------------------------------------------------------
// 3. 用高阶类型编写通用容器接口（`Functor<Container: Type => Type>`）
//
// 在函数式编程中，“函子（Functor）”是指任何支持 `.map(fn)` 映射内部元素、同时保持自身容器结构不变的泛型容器。
// 借助 `Container: Type => Type`，我们可以用同一个 `Functor` 接口统一描述所有这类容器！
// ----------------------------------------------------------------------------
// 3. Writing Unified Container Interfaces (`Functor<Container: Type => Type>`)
//
// In functional programming, a `Functor` is any generic container that supports mapping a function `(Input) => Output`
// over `Container<Input>` to produce `Container<Output>` while preserving the container's structure.
// With `Container: Type => Type`, we can express `Functor` once for any unary type constructor!
// ----------------------------------------------------------------------------

// 通用 `Functor` 接口：参数 `Container` 是一个一元类型构造器 `Type => Type`
// Generic `Functor` interface: `Container` is a unary type constructor of kind `Type => Type`
interface Functor<Container: Type => Type> {
    map<Input, Output>(value: Container<Input>, transform: (value: Input) => Output): Container<Output>;
}

// 既可以直接传入内置 `Array`，也可以传入前面定义的构造器别名 `Arrays`
// You can instantiate `Functor` with either built-in `Array` or the constructor alias `Arrays`
export type ArrayFunctor = Functor<Array>;
const arrayFunctor: Functor<Arrays> = {
    map: (values, transform) => values.map(transform),
};

// 调用 `arrayFunctor.map` 将 `number[]` 映射为 `string[]`
// Use `arrayFunctor.map` to transform a `number[]` into a `string[]`
const labels = arrayFunctor.map<number, string>([1, 2], value => `item-${value}`);
const checkedLabels: string[] = labels;

void strings;
void namedPair;
void box;
void checkedLabels;
