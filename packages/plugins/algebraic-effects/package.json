{
  "name": "@tspp/plugin-algebraic-effects",
  "version": "0.0.0",
  "description": "TSPP algebraic effects with capability passing.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tspp-lang/tspp.git",
    "directory": "packages/plugins/algebraic-effects"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "editor"],
  "scripts": {
    "build": "node ../../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "lint": "eslint src",
    "test": "pnpm build && pnpm test:run",
    "test:run": "node --test --test-concurrency=1 test/*.test.cjs",
    "typecheck": "node ../../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tspp/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "rimraf": "^6.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "typescript-upstream": "npm:typescript@6.0.3"
  }
}
