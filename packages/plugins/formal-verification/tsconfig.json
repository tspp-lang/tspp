{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "target": "ES2020",
    "types": ["node"],
    "plugins": [
      { "name": "ts-plus-plus/plugins/nominal-types", "tspp": true },
      { "name": "ts-plus-plus/plugins/formal-verification", "tspp": true }
    ]
  },
  "include": ["src/**/*.ts", "src/**/*.tspp"]
}
