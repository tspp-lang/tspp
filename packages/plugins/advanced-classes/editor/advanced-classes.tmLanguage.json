{
  "scopeName": "tspp.advanced-classes.injection",
  "injectionSelector": "L:source.tspp",
  "patterns": [
    {
      "comment": "data class Name(params) [extends/implements] — full primary-constructor declaration and optional body",
      "begin": "(?<![.\\w$])(?:(final|sealed)\\s+)?(data)(?![\\w$])\\s+(class)(?![\\w$])\\s+([A-Za-z_$][\\w$]*)",
      "beginCaptures": {
        "1": { "name": "storage.modifier.ts" },
        "2": { "name": "storage.modifier.data.tspp" },
        "3": { "name": "storage.type.class.ts" },
        "4": { "name": "entity.name.type.class.ts" }
      },
      "end": "(?<=\\})|(?=[;\\n]|$)",
      "name": "meta.declaration.class.data.tspp",
      "patterns": [
        {
          "begin": "(\\()",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.parameters.begin.ts" }
          },
          "end": "(\\))",
          "endCaptures": {
            "1": { "name": "punctuation.definition.parameters.end.ts" }
          },
          "patterns": [
            {
              "match": "\\b(val|var|readonly)\\b",
              "name": "storage.modifier.ts"
            },
            {
              "match": "([A-Za-z_$][\\w$]*)\\s*(?=[:,)]|$)",
              "captures": {
                "1": { "name": "variable.parameter.ts" }
              }
            },
            { "include": "source.ts#type-annotation" },
            { "include": "source.ts#punctuation-comma" },
            { "include": "source.ts" }
          ]
        },
        {
          "match": "\\b(extends|implements)\\b",
          "name": "storage.modifier.ts"
        },
        {
          "begin": "(\\{)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.block.ts" }
          },
          "end": "(\\})",
          "endCaptures": {
            "1": { "name": "punctuation.definition.block.ts" }
          },
          "patterns": [
            {
              "match": "\\b(public|private|protected|readonly|static|override|abstract|final|async)\\b",
              "name": "storage.modifier.ts"
            },
            {
              "match": "\\bfield\\b(?=\\s+[A-Za-z_$][\\w$]*)",
              "name": "storage.modifier.field.tspp"
            },
            {
              "match": "\\bfield\\b",
              "name": "variable.language.this.field.tspp"
            },
            {
              "match": "\\b([A-Za-z_$][\\w$]*)\\s*(?=\\()",
              "captures": {
                "1": { "name": "entity.name.function.ts" }
              }
            },
            {
              "match": "\\b([A-Za-z_$][\\w$]*)\\s*(?=:)",
              "captures": {
                "1": { "name": "variable.object.property.ts" }
              }
            },
            { "include": "source.ts" }
          ]
        },
        { "include": "source.ts" }
      ]
    },
    {
      "comment": "object Name [extends/implements] { ... } — singleton object declaration and body",
      "begin": "(?<![.\\w$])(object)(?![\\w$])\\s+([A-Za-z_$][\\w$]*)",
      "beginCaptures": {
        "1": { "name": "storage.type.class.object.tspp" },
        "2": { "name": "entity.name.type.class.object.tspp" }
      },
      "end": "(?<=\\})|(?=[;\\n]|$)",
      "name": "meta.declaration.object.tspp",
      "patterns": [
        {
          "match": "\\b(extends|implements)\\b",
          "name": "storage.modifier.ts"
        },
        {
          "begin": "(\\{)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.block.ts" }
          },
          "end": "(\\})",
          "endCaptures": {
            "1": { "name": "punctuation.definition.block.ts" }
          },
          "patterns": [
            {
              "match": "\\b(public|private|protected|readonly|static|override|abstract|final|async)\\b",
              "name": "storage.modifier.ts"
            },
            {
              "match": "\\bfield\\b(?=\\s+[A-Za-z_$][\\w$]*)",
              "name": "storage.modifier.field.tspp"
            },
            {
              "match": "\\bfield\\b",
              "name": "variable.language.this.field.tspp"
            },
            {
              "match": "\\b([A-Za-z_$][\\w$]*)\\s*(?=\\()",
              "captures": {
                "1": { "name": "entity.name.function.ts" }
              }
            },
            {
              "match": "\\b([A-Za-z_$][\\w$]*)\\s*(?=:)",
              "captures": {
                "1": { "name": "variable.object.property.ts" }
              }
            },
            { "include": "source.ts" }
          ]
        },
        { "include": "source.ts" }
      ]
    },
    {
      "match": "(?<![.\\w$])object(?![\\w$])(?=\\s+[A-Za-z_$][\\w$]*|$|\\))",
      "name": "storage.type.class.object.tspp"
    },
    {
      "match": "(?<![.\\w$])final(?![\\w$])(?=\\s+(?:class|abstract|data|sealed|public|private|protected|static|readonly|override|async|field|[A-Za-z_$][\\w$]*)|$|\\))",
      "name": "storage.modifier.final.tspp"
    },
    {
      "match": "(?<![.\\w$])sealed(?![\\w$])(?=\\s+(?:class|abstract|data|final|[A-Za-z_$][\\w$]*)|$|\\))",
      "name": "storage.modifier.sealed.tspp"
    },
    {
      "match": "(?<![.\\w$])data(?![\\w$])(?=\\s+(?:class|abstract|final|sealed\\b)|$|\\))",
      "name": "storage.modifier.data.tspp"
    },
    {
      "match": "(?<![.\\w$])with(?![\\w$])(?=\\s*\\()",
      "name": "keyword.control.with.tspp"
    },
    {
      "match": "(?<![.\\w$])field(?![\\w$])(?=\\s+[A-Za-z_$][\\w$]*)",
      "name": "storage.modifier.field.tspp"
    },
    {
      "match": "(?<![.\\w$])field(?![\\w$])(?!\\s*:)",
      "name": "variable.language.this.field.tspp"
    },
    {
      "match": "(?<![.\\w$])(extends|implements)(?![\\w$])",
      "name": "storage.modifier.ts"
    }
  ]
}
