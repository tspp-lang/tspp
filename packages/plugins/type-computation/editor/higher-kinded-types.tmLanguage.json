{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TS++ higher-kinded types",
  "scopeName": "source.tspp.higher-kinded-types",
  "injectionSelector": "L:source.tspp",
  "patterns": [
    {
      "match": "\\bType(?:0|[1-9]\\d*)?\\b",
      "name": "support.type.universe.tspp"
    }
  ]
}
