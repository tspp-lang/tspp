{
  "name": "ts-plus-plus-monorepo",
  "private": true,
  "devDependencies": {
    "ts-plus-plus": "workspace:*"
  },
  "scripts": {
    "build": "pnpm --filter ts-plus-plus build",
    "build:compiler": "pnpm --filter ts-plus-plus build:compiler",
    "build:tests": "pnpm --filter ts-plus-plus build:tests",
    "test": "pnpm --filter ts-plus-plus test",
    "test:eslint-rules": "pnpm --filter ts-plus-plus test:eslint-rules",
    "lint": "pnpm --filter ts-plus-plus lint",
    "knip": "pnpm --filter ts-plus-plus knip",
    "format": "pnpm --filter ts-plus-plus format",
    "clean": "pnpm --filter ts-plus-plus clean"
  },
  "packageManager": "pnpm@12.4.2",
  "volta": {
    "node": "22.22.0"
  }
}
