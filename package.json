{
  "name": "ts-plus-plus-monorepo",
  "private": true,
  "devDependencies": {
    "@tspp/plugin-let-in-expression": "workspace:*",
    "@tspp/plugin-formal-verification": "workspace:*",
    "@tspp/plugin-sdk": "workspace:*",
    "ts-plus-plus": "workspace:*",
    "tspp-language-server": "workspace:*"
  },
  "scripts": {
    "build": "pnpm build:plugin-sdk && pnpm build:plugins && pnpm build:compiler && pnpm build:language-server && pnpm build:vscode && pnpm build:tests",
    "build:plugin-sdk": "pnpm --filter @tspp/plugin-sdk build",
    "build:plugins": "pnpm --filter \"./packages/plugins/**\" build",
    "build:compiler": "pnpm --filter ts-plus-plus build:compiler",
    "build:language-server": "pnpm --filter tspp-language-server build",
    "build:tests": "pnpm --filter ts-plus-plus build:tests",
    "build:vscode": "pnpm --filter tspp-vscode build",
    "build:vscode:dev": "pnpm build:plugin-sdk && pnpm build:plugins && pnpm build:compiler && pnpm build:language-server && pnpm build:vscode",
    "test": "pnpm test:plugin-sdk && pnpm test:plugins && pnpm test:compiler && pnpm test:language-server && pnpm test:vscode",
    "test:compiler": "pnpm --filter ts-plus-plus test",
    "test:eslint-rules": "pnpm --filter ts-plus-plus test:eslint-rules",
    "test:language-server": "pnpm --filter tspp-language-server test:commit",
    "test:plugin-sdk": "pnpm --filter @tspp/plugin-sdk test",
    "test:plugins": "pnpm --filter \"./packages/plugins/**\" test",
    "test:vscode": "pnpm --filter tspp-vscode test",
    "lint": "pnpm lint:compiler && pnpm lint:language-server",
    "lint:compiler": "pnpm --filter ts-plus-plus lint",
    "lint:language-server": "pnpm --filter tspp-language-server lint",
    "knip": "pnpm --filter ts-plus-plus knip",
    "format": "pnpm --filter ts-plus-plus format",
    "clean": "pnpm --filter @tspp/plugin-sdk clean && pnpm --filter \"./packages/plugins/**\" clean && pnpm --filter ts-plus-plus clean && pnpm --filter tspp-language-server clean"
  },
  "packageManager": "pnpm@12.4.2",
  "volta": {
    "node": "22.22.0"
  }
}
