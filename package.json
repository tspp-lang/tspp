{
  "name": "ts-plus-plus-monorepo",
  "version": "0.1.0",
  "private": true,
  "devDependencies": {
    "@tspp/plugin-algebraic-effects": "workspace:*",
    "@tspp/plugin-advanced-classes": "workspace:*",
    "@tspp/plugin-formal-verification": "workspace:*",
    "@tspp/plugin-macros": "workspace:*",
    "@tspp/plugin-modern-syntax": "workspace:*",
    "@tspp/plugin-nominal-types": "workspace:*",
    "@tspp/plugin-operator-sections": "workspace:*",
    "@tspp/plugin-sdk": "workspace:*",
    "@tspp/plugin-static-interface-members": "workspace:*",
    "@tspp/plugin-type-computation": "workspace:*",
    "@tspp/plugin-typeclasses": "workspace:*",
    "lefthook": "^2.2.2",
    "ts-plus-plus": "workspace:*",
    "tspp-language-server": "workspace:*"
  },
  "scripts": {
    "build": "pnpm build:plugin-sdk && pnpm build:plugins && pnpm build:compiler && pnpm build:language-server && pnpm build:vscode && pnpm build:playground && pnpm build:tests",
    "build:plugin-sdk": "pnpm --filter @tspp/plugin-sdk build",
    "build:plugins": "pnpm --workspace-concurrency=1 --filter \"./packages/plugins/**\" build",
    "build:compiler": "pnpm --filter ts-plus-plus build:compiler",
    "build:language-server": "pnpm --filter tspp-language-server build",
    "build:tests": "pnpm --filter ts-plus-plus build:tests",
    "build:vscode": "pnpm --filter tspp-vscode build",
    "build:playground": "pnpm --filter tspp-playground build",
    "playground:dev": "pnpm --filter tspp-playground dev",
    "build:vscode:dev": "pnpm build:plugin-sdk && pnpm build:plugins && pnpm build:compiler && pnpm build:language-server && pnpm build:vscode",
    "test": "pnpm test:features && pnpm test:examples && pnpm test:compiler && pnpm test:language-server && pnpm test:editor-conformance:run && pnpm test:vscode",
    "test:features": "pnpm test:plugin-sdk && pnpm test:plugins && pnpm test:plugins:together && pnpm test:core-parity",
    "test:plugins:run": "pnpm --workspace-concurrency=1 --filter @tspp/plugin-sdk --filter \"./packages/plugins/**\" test:run",
    "test:plugins:together": "node scripts/test-plugins-together.mjs",
    "test:core-parity": "pnpm --filter @tspp/core-parity-tests test",
    "test:compiler": "pnpm --filter ts-plus-plus test",
    "test:compiler:tspp": "pnpm --filter ts-plus-plus exec hereby runtests --tests \"unittests:: (tspp::|MLTT)\" --lint=false",
    "test:eslint-rules": "pnpm --filter ts-plus-plus test:eslint-rules",
    "test:language-server": "pnpm --filter tspp-language-server test:commit",
    "test:editor-conformance": "pnpm --filter @tspp/editor-conformance test",
    "test:editor-conformance:run": "pnpm --filter @tspp/editor-conformance test:run",
    "test:plugin-sdk": "pnpm --filter @tspp/plugin-sdk test",
    "test:plugins": "pnpm --workspace-concurrency=1 --filter \"./packages/plugins/**\" test",
    "test:examples": "node packages/examples/scripts/check-all.mjs",
    "test:vscode": "pnpm --filter tspp-vscode test",
    "test:playground": "pnpm --filter tspp-playground test:smoke",
    "lint": "pnpm lint:compiler && pnpm lint:packages",
    "lint:compiler": "pnpm --filter ts-plus-plus lint",
    "lint:language-server": "pnpm --filter tspp-language-server lint",
    "lint:packages": "pnpm --workspace-concurrency=1 --filter @tspp/plugin-sdk --filter \"./packages/plugins/**\" --filter tspp-vscode --filter tspp-playground --filter \"./packages/examples/**\" lint",
    "pack:release": "node scripts/pack-release.mjs",
    "test:release": "node scripts/test-release.mjs",
    "knip": "pnpm --filter ts-plus-plus knip",
    "core-diff": "node scripts/core-diff.mjs",
    "core-diff:check": "node scripts/core-diff.mjs --check",
    "format": "pnpm --filter ts-plus-plus format",
    "prepare": "node scripts/install-lefthook.mjs",
    "clean": "pnpm --filter @tspp/plugin-sdk clean && pnpm --filter \"./packages/plugins/**\" clean && pnpm --filter ts-plus-plus clean && pnpm --filter tspp-language-server clean"
  },
  "packageManager": "pnpm@12.4.2",
  "volta": {
    "node": "22.22.0"
  }
}
